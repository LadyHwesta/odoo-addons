<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="domain_search_page" name="Domain Search">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="o_domain_search container py-5" style="max-width: 720px;">
                    <h1 class="mb-2">Find your domain</h1>
                    <p class="text-muted mb-4">
                        Search for a domain name and register it right here - pricing
                        includes registration for one year, renewed automatically each
                        year after (see your account for renewal details once ordered).
                    </p>
                    <form class="o_domain_search_form d-flex gap-2 mb-4">
                        <input
                            type="text"
                            class="form-control o_domain_search_input"
                            placeholder="yourdomain.com"
                            autocomplete="off"
                        />
                        <button type="submit" class="btn btn-secondary flex-shrink-0">Search</button>
                    </form>
                    <div class="o_domain_search_results" />
                </div>
            </div>
        </t>
    </template>

</odoo>
