<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_product_template_form_namecheap_sale" model="ir.ui.view">
        <field name="name">product.template.form.namecheap.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Domain Registration" name="namecheap_sale">
                    <group>
                        <field name="is_domain_registration" />
                    </group>
                    <group invisible="not is_domain_registration">
                        <field name="namecheap_server_id" />
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not is_domain_registration">
                        There should normally be only one such product - the domain
                        search page (see the "Sell a Domain" menu) always uses the
                        first one found with a Namecheap account set. Each order line
                        for it carries its own domain name and price, set at
                        add-to-cart time from a live Namecheap lookup - not from this
                        product's own sales price.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
