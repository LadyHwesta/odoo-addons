<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ir_cron_renew_domains" model="ir.cron">
        <field name="name">Namecheap: Auto-Charge and Renew Sold Domains</field>
        <field name="model_id" ref="model_namecheap_domain" />
        <field name="state">code</field>
        <field name="code">model._cron_renew_domains()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_check_namecheap_balance" model="ir.cron">
        <field name="name">Namecheap: Check Account Balance</field>
        <field name="model_id" ref="model_namecheap_server" />
        <field name="state">code</field>
        <field name="code">model._cron_check_balance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

</odoo>
