<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_form_activitypub" model="ir.ui.view">
        <field name="name">event.event.form.activitypub</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="activitypub_actor_id" options="{'no_create': True}"/>
            </field>
            <header position="inside">
                <button name="action_reset_activitypub_actor" type="object"
                        string="Reset Federate-as Actor from Category"
                        invisible="not event_type_id"
                        confirm="Overwrite this event's Federate-as actor with its category's current one?"
                        help="Use after correcting a mis-configured category default - it never propagates to already-published events on its own."/>
            </header>
        </field>
    </record>

    <record id="view_event_type_form_activitypub" model="ir.ui.view">
        <field name="name">event.type.form.activitypub</field>
        <field name="model">event.type</field>
        <field name="inherit_id" ref="event.view_event_type_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="activitypub_actor_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
