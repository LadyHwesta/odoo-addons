<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_signup_sign" model="ir.actions.report">
        <field name="name">Signup Sign</field>
        <field name="model">mailing.list</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mailing_list_signup_page.report_signup_sign</field>
        <field name="report_file">mailing_list_signup_page.report_signup_sign</field>
        <field name="print_report_name">'Signup sign - %s' % object.name</field>
        <field name="binding_model_id" ref="mass_mailing.model_mailing_list"/>
        <field name="binding_type">report</field>
    </record>

    <!-- A sign for a table at an event: title, big QR code, the address to type. -->
    <template id="report_signup_sign">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page text-center" style="padding-top: 30mm;">
                        <t t-if="o.signup_page_slug">
                            <h1 style="font-size: 40pt; margin-bottom: 6mm;" t-out="o.signup_page_title or o.name"/>
                            <p style="font-size: 18pt;">Scan with your phone's camera to join our mailing list.</p>
                            <img t-att-src="o.signup_page_qr_path" alt="QR code" style="width: 100mm; height: 100mm; margin: 8mm auto;"/>
                            <p style="font-size: 16pt;">or go to <strong t-out="o.signup_page_url.split('://', 1)[-1]"/></p>
                            <p t-if="o.signup_page_intro" style="font-size: 14pt; white-space: pre-line; margin-top: 10mm;" t-out="o.signup_page_intro"/>
                        </t>
                        <t t-else="">
                            <p style="font-size: 16pt;">The mailing list <strong t-out="o.name"/> has no signup page yet: give it a Signup Page Address first.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
