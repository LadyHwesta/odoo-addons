<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_task_form2_inherit_partner_assignee" model="ir.ui.view">
        <field name="name">project.task.form.inherit.partner.assignee</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="assignee_partner_id" />
            </field>
        </field>
    </record>

    <record id="project_task_view_tree_base_inherit_partner_assignee" model="ir.ui.view">
        <field name="name">project.task.view.list.base.inherit.partner.assignee</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_base" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="assignee_partner_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_task_search_form_inherit_partner_assignee" model="ir.ui.view">
        <field name="name">project.task.search.form.inherit.partner.assignee</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="assignee_partner_id" />
            </field>
            <filter name="group_by_properties" position="after">
                <separator />
                <filter string="Assigned Contact" name="group_by_assignee_partner"
                        context="{'group_by': 'assignee_partner_id'}" />
            </filter>
        </field>
    </record>

</odoo>
