<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_groups_privilege_team_folder" model="res.groups.privilege">
        <field name="name">Team Folders</field>
        <field name="category_id" ref="dms.category_dms_security" />
    </record>
    <record id="group_team_folder_manager" model="res.groups">
        <field name="name">Team Folder Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_team_folder" />
        <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]" />
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]" />
    </record>

    <!-- Group rules add up, so a manager's rule opens every folder while
         everyone else only gets the two membership rules. -->
    <record id="rule_team_folder_read" model="ir.rule">
        <field name="name">Team folder: members and viewers can read</field>
        <field name="model_id" ref="model_dms_team_folder" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">['|', ('member_ids', 'in', [user.id]), ('viewer_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_team_folder_edit" model="ir.rule">
        <field name="name">Team folder: only members can change files</field>
        <field name="model_id" ref="model_dms_team_folder" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="rule_team_folder_manager" model="ir.rule">
        <field name="name">Team folder: managers reach every folder</field>
        <field name="model_id" ref="model_dms_team_folder" />
        <field name="groups" eval="[(4, ref('group_team_folder_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_team_folder_company" model="ir.rule">
        <field name="name">Team folder: multi-company</field>
        <field name="model_id" ref="model_dms_team_folder" />
        <field name="global" eval="True" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
