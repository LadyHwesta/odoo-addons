<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_calendar_event_form_inherit_telehealth" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.telehealth</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_get_telehealth_video_link" type="object"
                        string="Get Telehealth Video Link"
                        invisible="videocall_location" />
            </xpath>
        </field>
    </record>

</odoo>
