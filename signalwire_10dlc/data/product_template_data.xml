<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Both left at list_price 0.0 - same placeholder convention as
         every other seeded product in this project. A price of 0
         means the corresponding charge is silently skipped (see
         signalwire.brand._charge_brand_fee /
         signalwire.campaign._start_billing) rather than invoicing a
         real customer $0 - set real prices before using this for
         real, matching what SignalWire itself actually charges plus
         whatever markup is wanted. -->

    <record id="product_signalwire_brand_fee" model="product.template">
        <field name="name">10DLC Brand Registration Fee</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False" />
        <field name="list_price">0.0</field>
    </record>

    <record id="product_signalwire_campaign_fee" model="product.template">
        <field name="name">10DLC Campaign Fee (Monthly, 3-Month Minimum)</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False" />
        <field name="list_price">0.0</field>
    </record>
</odoo>
