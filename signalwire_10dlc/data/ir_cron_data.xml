<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ir_cron_check_brand_status" model="ir.cron">
        <field name="name">SignalWire 10DLC: Check Brand Status</field>
        <field name="model_id" ref="model_signalwire_brand" />
        <field name="state">code</field>
        <field name="code">model._cron_check_brand_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_check_campaign_status" model="ir.cron">
        <field name="name">SignalWire 10DLC: Check Campaign Status</field>
        <field name="model_id" ref="model_signalwire_campaign" />
        <field name="state">code</field>
        <field name="code">model._cron_check_campaign_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_check_campaign_assignment_status" model="ir.cron">
        <field name="name">SignalWire 10DLC: Check Number-Campaign Assignment Status</field>
        <field name="model_id" ref="signalwire_voip.model_signalwire_phone_number" />
        <field name="state">code</field>
        <field name="code">model._cron_check_campaign_assignment_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

</odoo>
