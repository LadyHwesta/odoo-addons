<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_brand_list" model="ir.ui.view">
        <field name="name">signalwire.brand.list</field>
        <field name="model">signalwire.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_name" />
                <field name="partner_id" />
                <field name="legal_entity_type" />
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state in ('draft', 'submitted', 'pending')"
                       decoration-danger="state in ('rejected', 'failed')" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_brand_form" model="ir.ui.view">
        <field name="name">signalwire.brand.form</field>
        <field name="model">signalwire.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,pending,approved" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="server_id" />
                            <field name="name" />
                            <field name="company_name" />
                            <field name="csp_self_registered" />
                            <field name="csp_brand_reference"
                                   invisible="not csp_self_registered"
                                   required="csp_self_registered" />
                        </group>
                        <group invisible="csp_self_registered">
                            <field name="contact_email" />
                            <field name="contact_phone" />
                            <field name="ein_issuing_country" />
                            <field name="legal_entity_type" />
                            <field name="ein" />
                            <field name="company_vertical" />
                            <field name="company_website" />
                        </group>
                    </group>
                    <group string="Company Address" invisible="csp_self_registered">
                        <field name="company_address" nolabel="1" colspan="2" />
                    </group>
                    <group string="SignalWire Reference" invisible="not signalwire_brand_id">
                        <field name="signalwire_brand_id" readonly="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_signalwire_brand" model="ir.actions.act_window">
        <field name="name">10DLC Brands</field>
        <field name="res_model">signalwire.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
