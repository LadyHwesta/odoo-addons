<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="channel_amateur_radio" model="slide.channel">
        <field name="name">License &amp; Callsign Tracking</field>
        <field name="channel_type">training</field>
        <field name="description" type="html">
            <p>Looking up a member's FCC licence, and keeping it current
            without watching a calendar.</p>
        </field>
        <field name="visibility">members</field>
        <field name="enroll">invite</field>
        <field name="is_published" eval="True" />
        <field name="enroll_group_ids" eval="[(6, 0, [ref('membership.group_membership_manager')])]" />
    </record>

    <!-- ================ Section 1: Call sign lookup ================ -->
    <record id="section_lookup" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">Call sign lookup</field>
        <field name="is_category" eval="True" />
        <field name="sequence">10</field>
    </record>

    <record id="lesson_lookup" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">Looking up a call sign from the FCC</field>
        <field name="slide_category">article</field>
        <field name="sequence">11</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <ol class="oe-steps">
                    <li>
                        <p>Every contact has an <strong>Amateur Radio</strong>
                        tab.</p>
                    </li>
                    <li>
                        <p>Type a call sign.</p>
                    </li>
                    <li>
                        <p>Click <strong>Look up call sign</strong> to query
                        callook.info - a free, no-key JSON wrapper around the
                        FCC's own licence database.</p>
                    </li>
                </ol>

                <div class="oe-diagram">
                    <div class="oe-mock-bar">
                        <span class="oe-mock-dots"><span /><span /><span /></span>
                        Amateur Radio
                    </div>
                    <div class="oe-mock-body">
                        <p>
                            <span class="oe-badge">Operator Class</span>
                            <span class="oe-badge">Licence Type</span>
                            <span class="oe-badge">Grant &amp; Expiry</span>
                            <span class="oe-badge">FRN</span>
                            <span class="oe-badge">Grid Square</span>
                        </p>
                        <p class="mb-0 text-muted">For a club-station
                        licence, also the trustee's name and call sign.</p>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        what one lookup pulls in.
                    </p>
                </div>

                <div class="oe-callout oe-callout-good">
                    <span class="oe-callout-icon"><i class="fa fa-plug" /></span>
                    <div>
                        <span class="oe-callout-label">Nothing extra to install</span>
                        <p>No API key, no extra Python packages, just Odoo's
                        already-bundled <code>requests</code>.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_fills" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">What gets filled versus left alone</field>
        <field name="slide_category">article</field>
        <field name="sequence">12</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <div class="oe-columns">
                    <div class="oe-column">
                        <h4><i class="fa fa-id-badge" /> Licence fields</h4>
                        <p class="mb-0">Always overwritten from the lookup -
                        the FCC is the authority on those, so a fresh lookup
                        should always win.</p>
                    </div>
                    <div class="oe-column">
                        <h4><i class="fa fa-address-card-o" /> Name &amp; mailing address</h4>
                        <p class="mb-0">Only filled in when they're still
                        blank.</p>
                    </div>
                </div>

                <div class="oe-callout oe-callout-good">
                    <span class="oe-callout-icon"><i class="fa fa-shield" /></span>
                    <div>
                        <span class="oe-callout-label">Safe to re-run</span>
                        <p>A lookup on a brand-new member is one click that
                        sets everything up, but running it again later on an
                        existing member never clobbers a name or address
                        you've already typed by hand.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- ================ Section 2: Staying current ================ -->
    <record id="section_current" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">Staying current</field>
        <field name="is_category" eval="True" />
        <field name="sequence">20</field>
    </record>

    <record id="lesson_sweep" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">The daily expiry sweep and settings</field>
        <field name="slide_category">article</field>
        <field name="sequence">21</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <div class="oe-diagram">
                    <div class="oe-flow">
                        <div class="oe-flow-step">
                            <span class="oe-flow-step-icon"><i class="fa fa-moon-o" /></span>
                            Daily sweep
                        </div>
                        <span class="oe-flow-arrow"><i class="fa fa-long-arrow-right" /></span>
                        <div class="oe-flow-step">
                            <span class="oe-flow-step-icon"><i class="fa fa-refresh" /></span>
                            Refreshes every expiry date
                        </div>
                        <span class="oe-flow-arrow"><i class="fa fa-long-arrow-right" /></span>
                        <div class="oe-flow-step">
                            <span class="oe-flow-step-icon"><i class="fa fa-check-square-o" /></span>
                            One To-Do per lapsed member
                        </div>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        never a second To-Do for the same lapse. It pauses
                        briefly between lookups to be kind to callook.info,
                        and one bad call sign never stops the whole sweep
                        from finishing.
                    </p>
                </div>

                <div class="oe-callout">
                    <span class="oe-callout-icon"><i class="fa fa-cog" /></span>
                    <div>
                        <span class="oe-callout-label">Settings &gt; Amateur Radio Club</span>
                        <p>Turn <strong>FCC call-sign lookup</strong> off
                        entirely for an air-gapped install (the fields stay
                        editable by hand), and set the <strong>Licence
                        expiry warning window</strong> - how many days
                        before expiry a licence counts as "expiring soon"
                        (default 60).</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- ========================= Quiz ========================= -->
    <record id="slide_quiz" model="slide.slide">
        <field name="channel_id" ref="channel_amateur_radio" />
        <field name="name">Check your understanding</field>
        <field name="slide_category">quiz</field>
        <field name="sequence">90</field>
    </record>

    <record id="quiz_q1" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">1</field>
        <field name="question">You look up a call sign for an existing member whose name is already filled in. What happens to their name?</field>
    </record>
    <record id="quiz_q1_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">1</field>
        <field name="text_value">It's overwritten with whatever the FCC has on file</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">2</field>
        <field name="text_value">It's left alone, since it isn't blank</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q1_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">3</field>
        <field name="text_value">The lookup fails and shows an error</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">4</field>
        <field name="text_value">The member has to confirm the change first</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q2" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">2</field>
        <field name="question">Are the licence fields (class, expiry, etc.) treated the same way as name/address?</field>
    </record>
    <record id="quiz_q2_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">1</field>
        <field name="text_value">No - licence fields always get overwritten from the FCC, since it's the authority on those</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q2_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">2</field>
        <field name="text_value">Yes - both only fill in when blank</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">3</field>
        <field name="text_value">Licence fields are never updated after the first lookup</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">4</field>
        <field name="text_value">Only an administrator can update licence fields</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q3" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">3</field>
        <field name="question">A member's licence expired two weeks ago and got a To-Do raised. It's still expired the next day the sweep runs. What happens?</field>
    </record>
    <record id="quiz_q3_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">1</field>
        <field name="text_value">A second, duplicate To-Do is raised</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">2</field>
        <field name="text_value">No new To-Do - it doesn't raise a second one for the same lapse</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q3_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">3</field>
        <field name="text_value">The member is automatically removed from the roster</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">4</field>
        <field name="text_value">The existing To-Do is silently deleted</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q4" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">4</field>
        <field name="question">How do you turn off FCC lookups for an air-gapped install?</field>
    </record>
    <record id="quiz_q4_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">1</field>
        <field name="text_value">Settings &gt; Amateur Radio Club &gt; FCC call-sign lookup</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q4_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">2</field>
        <field name="text_value">Uninstall the module entirely</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">3</field>
        <field name="text_value">Delete the callsign field from every contact</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">4</field>
        <field name="text_value">It can't be turned off</field>
        <field name="is_correct" eval="False" />
    </record>

</odoo>
