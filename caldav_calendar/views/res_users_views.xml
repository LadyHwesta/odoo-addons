<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Self-service "Preferences" popup: any user can configure their own CalDAV account here.
         "other_preferences" is the placeholder group base/views/res_users_views.xml explicitly
         reserves for this kind of override (see the "mail" module's notification settings for
         the same pattern). -->
    <record id="view_users_form_simple_modif_caldav" model="ir.ui.view">
        <field name="name">res.users.preferences.form.caldav</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <span class="o_form_label fw-bold">CalDAV Calendar Sync</span>
                <field name="caldav_sync_status" widget="badge"
                       decoration-success="caldav_sync_status == 'active'"
                       decoration-warning="caldav_sync_status == 'paused'"
                       decoration-danger="caldav_sync_status == 'error'"/>
                <field name="caldav_discovery_url" placeholder="https://cloud.example.com/"/>
                <field name="caldav_username"/>
                <field name="caldav_password" password="True"/>
                <field name="caldav_url" placeholder="https://cloud.example.com/remote.php/dav/calendars/john/personal/"/>
                <field name="caldav_last_sync" readonly="1"/>
                <field name="caldav_last_sync_error" readonly="1" invisible="not caldav_last_sync_error"/>
                <div class="o_row" name="caldav_buttons">
                    <button name="action_caldav_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_caldav_discover_calendars" type="object" string="Discover Calendars" class="btn-secondary"/>
                    <button name="action_caldav_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Full admin user form (Settings > Users): same fields, for admins managing other users -->
    <record id="view_users_form_caldav" model="ir.ui.view">
        <field name="name">res.users.form.caldav</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <span class="o_form_label fw-bold">CalDAV Calendar Sync</span>
                <field name="caldav_sync_status" widget="badge"
                       decoration-success="caldav_sync_status == 'active'"
                       decoration-warning="caldav_sync_status == 'paused'"
                       decoration-danger="caldav_sync_status == 'error'"/>
                <field name="caldav_discovery_url" placeholder="https://cloud.example.com/"/>
                <field name="caldav_username"/>
                <field name="caldav_password" password="True"/>
                <field name="caldav_url" placeholder="https://cloud.example.com/remote.php/dav/calendars/john/personal/"/>
                <field name="caldav_last_sync" readonly="1"/>
                <field name="caldav_last_sync_error" readonly="1" invisible="not caldav_last_sync_error"/>
                <div class="o_row" name="caldav_buttons">
                    <button name="action_caldav_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_caldav_discover_calendars" type="object" string="Discover Calendars" class="btn-secondary"/>
                    <button name="action_caldav_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
