<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caldav_account_form" model="ir.ui.view">
        <field name="name">caldav.account.form</field>
        <field name="model">caldav.account</field>
        <field name="arch" type="xml">
            <form string="CalDAV Calendar Account">
                <header>
                    <button name="action_caldav_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_caldav_discover_calendars" type="object" string="Discover Calendars" class="btn-secondary"/>
                    <button name="action_caldav_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="user_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Personal, Work"/></h1>
                    </div>
                    <group>
                        <group string="Status">
                            <field name="active"/>
                            <field name="read_only"/>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'active'"
                                   decoration-warning="sync_status == 'paused'"
                                   decoration-danger="sync_status == 'error'"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_error" readonly="1" invisible="not last_sync_error"/>
                        </group>
                        <group string="Connection">
                            <field name="discovery_url" placeholder="https://cloud.example.com/"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="url" placeholder="https://cloud.example.com/remote.php/dav/calendars/john/personal/"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_caldav_account_list" model="ir.ui.view">
        <field name="name">caldav.account.list</field>
        <field name="model">caldav.account</field>
        <field name="arch" type="xml">
            <list string="CalDAV Calendar Accounts">
                <field name="name"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'active'"
                       decoration-warning="sync_status == 'paused'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="read_only" optional="show"/>
                <field name="url"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="action_caldav_account" model="ir.actions.act_window">
        <field name="name">My CalDAV Calendar Accounts</field>
        <field name="res_model">caldav.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

</odoo>
