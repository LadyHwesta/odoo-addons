<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="voip_search_page" name="VoIP Number Search">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="o_voip_search container py-5" style="max-width: 720px;">
                    <h1 class="mb-2">Get a phone number</h1>
                    <p class="text-muted mb-4">
                        Search by area code and pick a number - billed monthly, plus
                        actual usage (calls and texts) at the end of each period.
                    </p>
                    <form class="o_voip_search_form d-flex gap-2 mb-4">
                        <input
                            type="text"
                            class="form-control o_voip_search_input"
                            placeholder="Area code, e.g. 415 (optional)"
                            autocomplete="off"
                        />
                        <button type="submit" class="btn btn-secondary flex-shrink-0">Search</button>
                    </form>
                    <div class="o_voip_search_results" />
                </div>
            </div>
        </t>
    </template>

</odoo>
