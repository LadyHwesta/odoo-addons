<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="signalwire_voip_piper_tts.PiperPreviewWidget" owl="1">
        <div class="o_piper_preview d-flex align-items-center gap-2 mt-1" t-if="voice">
            <button
                type="button"
                class="btn btn-secondary text-nowrap"
                t-att-disabled="!canPreview"
                t-on-click="onPreviewClick"
            >
                <i t-if="state.loading" class="fa fa-spinner fa-spin" role="img" aria-label="Loading" title="Loading" />
                <i t-else="" class="fa fa-play" role="img" aria-label="Preview" title="Preview" />
                Preview
            </button>
            <span class="text-muted small" t-if="text">Reads the text above aloud in this voice.</span>
            <span class="text-muted small" t-else="">Type the text above to preview it.</span>
        </div>
    </t>

</templates>
