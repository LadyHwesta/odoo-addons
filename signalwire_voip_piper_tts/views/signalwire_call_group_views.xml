<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_call_group_form_inherit_piper_tts" model="ir.ui.view">
        <field name="name">signalwire.call.group.form.inherit.piper.tts</field>
        <field name="model">signalwire.call.group</field>
        <field name="inherit_id" ref="signalwire_voip_click2call.view_signalwire_call_group_form" />
        <field name="arch" type="xml">
            <group name="voicemail_voice" position="inside">
                <field name="voicemail_piper_voice" />
                <field name="voicemail_piper_speaker_id"
                       invisible="voicemail_piper_voice != 'en_US-libritts_r-medium'" />
                <widget name="piper_preview" colspan="2" invisible="not voicemail_piper_voice"
                        options="{'voice_field': 'voicemail_piper_voice', 'speaker_field': 'voicemail_piper_speaker_id', 'text_field': 'voicemail_greeting_text'}" />
            </group>
            <group name="hold_voice" position="inside">
                <field name="hold_piper_voice" />
                <field name="hold_piper_speaker_id"
                       invisible="hold_piper_voice != 'en_US-libritts_r-medium'" />
                <widget name="piper_preview" colspan="2" invisible="not hold_piper_voice"
                        options="{'voice_field': 'hold_piper_voice', 'speaker_field': 'hold_piper_speaker_id', 'text_field': 'hold_message_text'}" />
            </group>
        </field>
    </record>

</odoo>
