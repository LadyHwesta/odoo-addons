<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_server_form" model="ir.ui.view">
        <field name="name">signalwire.server.form</field>
        <field name="model">signalwire.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary" />
                    <button name="action_import_numbers" type="object"
                            string="Import Numbers"
                            help="Load the numbers this account already owns, e.g. when this Odoo is connected to a sub-account set up elsewhere." />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="space" placeholder="yourcompany.example.com" />
                        <field name="project_id" />
                        <field name="api_token" password="True" />
                    </group>
                    <group string="Webhook Security">
                        <group>
                            <field name="signing_key" password="True"
                                   placeholder="API Credentials &gt; Signing Key" />
                            <field name="webhook_signature_mode" widget="radio" />
                        </group>
                        <group>
                            <field name="webhook_last_valid" />
                            <field name="webhook_last_invalid" />
                            <field name="webhook_last_invalid_path" invisible="not webhook_last_invalid" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_signalwire_server_list" model="ir.ui.view">
        <field name="name">signalwire.server.list</field>
        <field name="model">signalwire.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="space" />
            </list>
        </field>
    </record>

    <record id="action_signalwire_server" model="ir.actions.act_window">
        <field name="name">Phone Accounts</field>
        <field name="res_model">signalwire.server</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
