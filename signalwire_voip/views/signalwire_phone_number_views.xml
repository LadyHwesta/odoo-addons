<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_list" model="ir.ui.view">
        <field name="name">signalwire.phone_number.list</field>
        <field name="model">signalwire.phone_number</field>
        <field name="arch" type="xml">
            <list create="0" expand="1">
                <field name="name" class="text-nowrap" width="140px" />
                <field name="number_use" column_invisible="1" />
                <field name="subproject_id" optional="hide" />
                <field name="partner_id" optional="show" width="160px" />
                <field name="e911_status" string="E911" widget="badge" width="130px"
                       decoration-success="e911_status == 'active'"
                       decoration-warning="e911_status in ('none', 'pending', 'pending_removal', 'unregistered')"
                       decoration-danger="e911_status == 'failed'" />
                <field name="cnam_name" string="Caller ID Name" optional="hide" />
                <field name="cnam_status" string="Caller ID" widget="badge" optional="show" width="120px"
                       decoration-success="cnam_status == 'approved'"
                       decoration-warning="cnam_status in ('pending', 'in_review')"
                       decoration-danger="cnam_status in ('rejected', 'failed')" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_phone_number_form" model="ir.ui.view">
        <field name="name">signalwire.phone_number.form</field>
        <field name="model">signalwire.phone_number</field>
        <field name="arch" type="xml">
            <form create="0">
                <header />
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <field name="number_use" invisible="1" />
                    <field name="is_toll_free" invisible="1" />
                    <div class="alert alert-info" role="alert" invisible="number_use != 'customer'">
                        This is <field name="partner_id" readonly="1" class="d-inline fw-bold" />'s
                        number. Where its calls go, its E911 and its caller ID name are managed in
                        their own Odoo, so they can't be changed from here.
                    </div>
                    <group>
                        <field name="subproject_id" readonly="1" />
                        <field name="partner_id" readonly="1" />
                        <field name="sid" readonly="1" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group string="Emergency (E911)" name="e911" invisible="number_use == 'customer'">
                        <div class="alert alert-warning mb-2" role="alert" colspan="2"
                             invisible="e911_status == 'active'">
                            Until E911 is active, this number can't be used to call outside numbers,
                            911 included. Choose a registered emergency address and click Assign.
                        </div>
                        <field name="e911_address_id" options="{'no_create': true}"
                               readonly="e911_status in ('pending', 'active', 'pending_removal')" />
                        <field name="e911_status" widget="badge"
                               decoration-success="e911_status == 'active'"
                               decoration-danger="e911_status == 'failed'" />
                        <field name="e911_checked_at" invisible="not e911_checked_at" />
                        <div colspan="2" class="d-flex gap-2">
                            <button name="action_assign_e911" type="object" string="Assign"
                                    class="btn-primary"
                                    invisible="not e911_address_id or e911_status in ('pending', 'active', 'pending_removal')" />
                            <button name="action_refresh_e911" type="object" string="Check Status" />
                            <button name="action_remove_e911" type="object" string="Remove"
                                    invisible="e911_status not in ('active', 'failed', 'pending')"
                                    confirm="Remove the emergency address? This number will stop being able to call outside numbers." />
                        </div>
                    </group>
                    <group string="Caller ID Name" name="cnam" invisible="number_use == 'customer'">
                        <div colspan="2" class="text-muted" invisible="is_toll_free">
                            The name people see when this number calls them (US carriers; not shown
                            to Canadian phones). Up to 15 characters. The phone provider reviews each
                            request; once approved it can take up to 48 hours to appear.
                        </div>
                        <div colspan="2" class="text-muted" invisible="not is_toll_free">
                            Carriers don't show caller ID names for toll-free numbers.
                        </div>
                        <field name="cnam_name" placeholder="e.g. MESKIS WORKS" invisible="is_toll_free" />
                        <field name="cnam_status" widget="badge" invisible="is_toll_free"
                               decoration-success="cnam_status == 'approved'"
                               decoration-warning="cnam_status in ('pending', 'in_review')"
                               decoration-danger="cnam_status in ('rejected', 'failed')" />
                        <field name="cnam_reason" invisible="not cnam_reason" />
                        <field name="cnam_checked_at" invisible="not cnam_checked_at" />
                        <div colspan="2" class="d-flex gap-2" invisible="is_toll_free">
                            <button name="action_request_cnam" type="object" string="Request Caller ID Name"
                                    class="btn-primary" />
                            <button name="action_refresh_cnam" type="object" string="Check Status"
                                    invisible="cnam_status == 'none'" />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_signalwire_phone_number_search" model="ir.ui.view">
        <field name="name">signalwire.phone_number.search</field>
        <field name="model">signalwire.phone_number</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="subproject_id" />
                <filter name="no_e911" string="Without E911"
                        domain="[('e911_status', '!=', 'active')]" />
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}" />
                    <filter name="group_subproject" string="Sub-account"
                            context="{'group_by': 'subproject_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Our own numbers only: customers' are under Customers. -->
    <record id="action_signalwire_phone_number" model="ir.actions.act_window">
        <field name="name">Phone Numbers</field>
        <field name="res_model">signalwire.phone_number</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('number_use', '=', 'own')]</field>
        <field name="search_view_id" ref="view_signalwire_phone_number_search" />
    </record>

    <record id="view_signalwire_phone_number_customer_list" model="ir.ui.view">
        <field name="name">signalwire.phone_number.customer.list</field>
        <field name="model">signalwire.phone_number</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" class="text-nowrap" width="140px" />
                <field name="partner_id" string="Customer" />
                <field name="subproject_id" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_signalwire_customer_phone_number" model="ir.actions.act_window">
        <field name="name">Customer Numbers</field>
        <field name="res_model">signalwire.phone_number</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('number_use', '=', 'customer')]</field>
        <field name="search_view_id" ref="view_signalwire_phone_number_search" />
        <field name="context">{'search_default_group_customer': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_signalwire_phone_number_customer_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_signalwire_phone_number_form')})]" />
        <field name="help" type="html">
            <p>Numbers resold to customers. Their routing, E911 and caller ID name are
            managed in each customer's own Odoo.</p>
        </field>
    </record>

    <record id="action_server_request_cnam" model="ir.actions.server">
        <field name="name">Request Caller ID Name</field>
        <field name="model_id" ref="model_signalwire_phone_number" />
        <field name="binding_model_id" ref="model_signalwire_phone_number" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_request_cnam()</field>
    </record>

</odoo>
