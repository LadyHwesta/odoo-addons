<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_subproject_form" model="ir.ui.view">
        <field name="name">signalwire.subproject.form</field>
        <field name="model">signalwire.subproject</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_provision" type="object"
                            string="Provision" class="btn-primary"
                            invisible="account_sid" />
                    <button name="action_open_number_search" type="object"
                            string="Search Phone Numbers"
                            invisible="state != 'active'" />
                    <button name="action_close" type="object"
                            string="Close" invisible="state != 'active'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="account_sid" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Phone Numbers" name="phone_numbers">
                            <field name="phone_number_ids">
                                <list editable="bottom" create="0">
                                    <field name="name" readonly="1" />
                                    <field name="sid" readonly="1" />
                                    <button name="action_release" type="object"
                                            string="Release" class="btn-danger" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_signalwire_subproject_list" model="ir.ui.view">
        <field name="name">signalwire.subproject.list</field>
        <field name="model">signalwire.subproject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'" />
            </list>
        </field>
    </record>

    <record id="action_signalwire_subproject" model="ir.actions.act_window">
        <field name="name">Subprojects</field>
        <field name="res_model">signalwire.subproject</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
