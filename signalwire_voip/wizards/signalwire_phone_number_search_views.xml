<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_search_form" model="ir.ui.view">
        <field name="name">signalwire.phone_number.search.form</field>
        <field name="model">signalwire.phone_number.search</field>
        <field name="arch" type="xml">
            <form>
                <field name="subproject_id" invisible="1" />
                <group>
                    <field name="country" />
                    <field name="area_code" placeholder="e.g. 415" />
                </group>
                <field name="result_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="phone_number" readonly="1" />
                        <button name="action_purchase" type="object"
                                string="Purchase" class="btn-primary" />
                    </list>
                </field>
                <footer>
                    <button name="action_search" type="object"
                            string="Search" class="btn-primary" />
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
