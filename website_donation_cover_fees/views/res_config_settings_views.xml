<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.donation.cover.fees</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_payment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="website_payment_setting" position="after">
                <setting id="donation_cover_fees_setting" string="Donors Can Cover the Fees"
                         help="An unticked box on the donation form adds the processing fees to the gift, so the full gift arrives.">
                    <field name="donation_cover_fees"/>
                    <div class="content-group mt-2" invisible="not donation_cover_fees">
                        <div class="row">
                            <label for="donation_fee_percent" class="col-lg-4 o_light_label"/>
                            <field name="donation_fee_percent" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="donation_fee_fixed" class="col-lg-4 o_light_label"/>
                            <field name="donation_fee_fixed" class="col-lg-2"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
