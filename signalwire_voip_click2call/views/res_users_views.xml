<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_users_form_inherit_signalwire" model="ir.ui.view">
        <field name="name">res.users.form.inherit.signalwire</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="voip_oca.view_users_form" />
        <field name="arch" type="xml">
            <page name="voip" position="inside">
                <div class="mb-3">
                    <button name="action_provision_signalwire_sip" type="object"
                            string="Provision SignalWire Softphone" class="btn-primary"
                            invisible="signalwire_sip_endpoint_id" />
                    <button name="action_release_signalwire_sip" type="object"
                            string="Release SignalWire Softphone" class="btn-secondary"
                            invisible="not signalwire_sip_endpoint_id" />
                </div>
                <group string="If I don't answer..." invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_forwarding_number_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name" placeholder="e.g. Cell" />
                            <field name="phone_number" placeholder="+15551234567" />
                        </list>
                    </field>
                    <button name="action_use_profile_phone_as_forward" type="object"
                            string="Use My Profile Phone" class="btn-link" colspan="2" />
                    <field name="signalwire_active_forward_id"
                           options="{'no_create': True}" />
                    <field name="signalwire_ring_group_ids" widget="many2many_tags"
                           domain="[('signalwire_sip_endpoint_id', '!=', False)]" />
                    <field name="signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_transcribe"
                           invisible="not signalwire_voicemail_enabled" />
                </group>
            </page>
        </field>
    </record>

    <record id="view_users_form_simple_modif_inherit_signalwire" model="ir.ui.view">
        <field name="name">res.users.form.simple.modif.inherit.signalwire</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="voip_oca.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <page name="voip" position="inside">
                <div class="mb-3">
                    <button name="action_provision_signalwire_sip" type="object"
                            string="Provision SignalWire Softphone" class="btn-primary"
                            invisible="signalwire_sip_endpoint_id" />
                    <button name="action_release_signalwire_sip" type="object"
                            string="Release SignalWire Softphone" class="btn-secondary"
                            invisible="not signalwire_sip_endpoint_id" />
                </div>
                <group string="If I don't answer..." invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_forwarding_number_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name" placeholder="e.g. Cell" />
                            <field name="phone_number" placeholder="+15551234567" />
                        </list>
                    </field>
                    <button name="action_use_profile_phone_as_forward" type="object"
                            string="Use My Profile Phone" class="btn-link" colspan="2" />
                    <field name="signalwire_active_forward_id"
                           options="{'no_create': True}" />
                    <field name="signalwire_ring_group_ids" widget="many2many_tags"
                           domain="[('signalwire_sip_endpoint_id', '!=', False)]" />
                    <field name="signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_transcribe"
                           invisible="not signalwire_voicemail_enabled" />
                </group>
            </page>
        </field>
    </record>

</odoo>
