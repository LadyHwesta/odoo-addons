<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_users_form_inherit_signalwire" model="ir.ui.view">
        <field name="name">res.users.form.inherit.signalwire</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="voip_oca.view_users_form" />
        <field name="arch" type="xml">
            <page name="voip" position="inside">
                <div class="mb-3">
                    <button name="action_provision_signalwire_sip" type="object"
                            string="Set Up Softphone" class="btn-primary"
                            invisible="signalwire_sip_endpoint_id" />
                    <button name="action_release_signalwire_sip" type="object"
                            string="Release Softphone" class="btn-secondary"
                            invisible="not signalwire_sip_endpoint_id" />
                    <!-- Which phone account this softphone lives in: the same login name can exist in
                         two databases' accounts (each its own softphone), which looked like one. -->
                    <span class="text-muted ms-2" invisible="not signalwire_sip_endpoint_id">
                        Softphone <field name="voip_username" readonly="1" class="d-inline fw-bold"/>
                        in phone account <field name="signalwire_phone_account_name" class="d-inline fw-bold"/>
                    </span>
                </div>
                <group string="Outside calls" invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_outbound_number_id" options="{'no_create': true}" />
                    <field name="signalwire_outbound_allowed" readonly="1" />
                    <div colspan="2" groups="base.group_system" invisible="not signalwire_outbound_allowed">
                        <button name="action_signalwire_outbound_via_odoo" type="object" class="btn-link px-0"
                                string="Test: outside calls through Odoo"
                                help="Live test: this softphone asks Odoo for each outside call. Calls still go out as the Calls Out As number."/>
                        <span class="text-muted mx-2">·</span>
                        <button name="action_signalwire_outbound_direct" type="object" class="btn-link px-0"
                                string="Back to direct"/>
                    </div>
                    <div colspan="2" class="text-muted" invisible="signalwire_outbound_allowed">
                        Internal calls only until the Calls Out As number has active E911
                        (VoIP › Phone Numbers). 911 can't be dialled from these phones until then.
                    </div>
                </group>
                <group string="Presence" invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_presence" />
                    <field name="signalwire_auto_away_minutes" />
                    <field name="signalwire_mobile_forward_id" options="{'no_create': True}" />
                    <div colspan="2" class="text-muted">
                        Away skips you; Mobile also rings your mobile number. Change it any time
                        from the status menu in the top bar, or press Alt+Shift+W (Control+Shift+W on a Mac) to go Away.
                        Pick the mobile number from your saved numbers below.
                    </div>
                </group>
                <group string="If I don't answer..." invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_forwarding_number_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name" placeholder="e.g. Cell" />
                            <field name="phone_number" placeholder="+15551234567" />
                        </list>
                    </field>
                    <button name="action_use_profile_phone_as_forward" type="object"
                            string="Use My Profile Phone" class="btn-link" colspan="2" />
                    <field name="signalwire_active_forward_id"
                           options="{'no_create': True}" />
                    <field name="signalwire_ring_group_ids" widget="many2many_tags"
                           domain="[('signalwire_sip_endpoint_id', '!=', False)]" />
                    <field name="signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_transcribe"
                           invisible="not signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_max_length"
                           invisible="not signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_beep"
                           invisible="not signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_greeting_text"
                           invisible="not signalwire_voicemail_enabled" />
                    <field name="signalwire_voicemail_greeting_filename" invisible="1" />
                    <field name="signalwire_voicemail_greeting"
                           filename="signalwire_voicemail_greeting_filename"
                           invisible="not signalwire_voicemail_enabled" />
                </group>
                <group string="Desk Phones" invisible="not signalwire_sip_endpoint_id">
                    <field name="signalwire_desk_phone_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name" placeholder="e.g. Front Desk" />
                            <field name="mac_address" placeholder="aa:bb:cc:dd:ee:ff" />
                            <field name="brand" />
                            <field name="provisioning_url" readonly="1" />
                            <button name="action_provision" type="object"
                                    string="Provision" class="btn-link"
                                    invisible="signalwire_sip_endpoint_id" />
                            <button name="action_release" type="object"
                                    string="Release" class="btn-link"
                                    invisible="not signalwire_sip_endpoint_id" />
                        </list>
                    </field>
                </group>
            </page>
        </field>
    </record>

