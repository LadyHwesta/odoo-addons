<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_voicemail_list" model="ir.ui.view">
        <field name="name">signalwire.voicemail.list</field>
        <field name="model">signalwire.voicemail</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" />
                <field name="user_id" />
                <field name="from_number" />
                <field name="partner_id" />
                <field name="duration" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_voicemail_form" model="ir.ui.view">
        <field name="name">signalwire.voicemail.form</field>
        <field name="model">signalwire.voicemail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="from_number" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="phone_number_id" />
                            <field name="duration" />
                        </group>
                    </group>
                    <field name="recording_attachment_id" />
                    <p class="text-muted">Open the attachment above to play or
                        download the recording.</p>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_signalwire_voicemail" model="ir.actions.act_window">
        <field name="name">Voicemail</field>
        <field name="res_model">signalwire.voicemail</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_signalwire_voicemail" name="Voicemail"
              action="action_signalwire_voicemail" parent="signalwire_voip.menu_signalwire_root"
              sequence="17" />

</odoo>
