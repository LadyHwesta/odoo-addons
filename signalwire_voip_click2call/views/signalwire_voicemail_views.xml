<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_voicemail_list" model="ir.ui.view">
        <field name="name">signalwire.voicemail.list</field>
        <field name="model">signalwire.voicemail</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-bf="not is_read">
                <field name="is_read" column_invisible="1" />
                <field name="create_date" />
                <field name="user_id" />
                <field name="call_group_id" />
                <field name="from_number" widget="phone" />
                <field name="partner_id" />
                <field name="duration" />
                <field name="transcription_status" widget="badge"
                       decoration-success="transcription_status == 'completed'"
                       decoration-warning="transcription_status == 'pending'"
                       decoration-danger="transcription_status == 'failed'" />
                <field name="transcription_text" string="Transcript" optional="show" />
                <field name="recording_download_url" string="Recording"
                       widget="signalwire_voicemail_player" />
                <button name="action_mark_read" type="object" icon="fa-envelope-open-o"
                        string="Mark Read" invisible="is_read" />
                <button name="action_mark_unread" type="object" icon="fa-envelope-o"
                        string="Mark Unread" invisible="not is_read" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_voicemail_form" model="ir.ui.view">
        <field name="name">signalwire.voicemail.form</field>
        <field name="model">signalwire.voicemail</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_read" type="object" string="Mark Read"
                            class="btn-primary" invisible="is_read" />
                    <button name="action_mark_unread" type="object" string="Mark Unread"
                            class="btn-secondary" invisible="not is_read" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Unread" bg_color="text-bg-warning"
                            invisible="is_read" />
                    <field name="is_read" invisible="1" />
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="call_group_id" />
                            <field name="from_number" widget="phone" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="phone_number_id" />
                            <field name="duration" />
                            <field name="transcription_status" />
                        </group>
                    </group>
                    <group string="Recording">
                        <field name="recording_download_url" nolabel="1" colspan="2"
                               widget="signalwire_voicemail_player" />
                    </group>
                    <group string="Transcript" invisible="not transcription_text">
                        <field name="transcription_text" nolabel="1" colspan="2" readonly="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_signalwire_voicemail_search" model="ir.ui.view">
        <field name="name">signalwire.voicemail.search</field>
        <field name="model">signalwire.voicemail</field>
        <field name="arch" type="xml">
            <search>
                <field name="from_number" />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="call_group_id" />
                <field name="transcription_text" string="Transcript" />
                <filter name="my" string="My Voicemails" domain="[('user_id', '=', uid)]" />
                <filter name="my_groups" string="My Groups' Voicemails"
                        domain="[('call_group_id.member_ids', 'in', [uid])]" />
                <filter name="unread" string="Unread" domain="[('is_read', '=', False)]" />
                <filter name="transcribed" string="Transcribed"
                        domain="[('transcription_status', '=', 'completed')]" />
                <group>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}" />
                    <filter name="group_by_call_group" string="Call Group"
                            context="{'group_by': 'call_group_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_signalwire_voicemail" model="ir.actions.act_window">
        <field name="name">Voicemail</field>
        <field name="res_model">signalwire.voicemail</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_signalwire_voicemail_search" />
        <field name="context">{'search_default_my': 1, 'search_default_unread': 1}</field>
    </record>

    <menuitem id="menu_signalwire_voicemail" name="Voicemail"
              action="action_signalwire_voicemail" parent="signalwire_voip.menu_signalwire_root"
              sequence="17" />

</odoo>
