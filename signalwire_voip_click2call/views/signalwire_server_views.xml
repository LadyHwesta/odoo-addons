<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_server_form_inherit_click2call" model="ir.ui.view">
        <field name="name">signalwire.server.form.inherit.click2call</field>
        <field name="model">signalwire.server</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_server_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_setup_click2call" type="object"
                        string="Setup Click-to-Call" />
            </xpath>
            <xpath expr="//field[@name='space']" position="after">
                <field name="sip_domain" />
            </xpath>
        </field>
    </record>

</odoo>
