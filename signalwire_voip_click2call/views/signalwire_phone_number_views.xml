<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_list_inherit_click2call" model="ir.ui.view">
        <field name="name">signalwire.phone_number.list.inherit.click2call</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_list" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="route_type" column_invisible="1" />
                <field name="call_group_id" column_invisible="1" />
                <field name="ivr_menu_id" column_invisible="1" />
                <field name="assigned_user_id" />
                <button name="action_configure_inbound_routing" type="object"
                        string="Configure Inbound Routing"
                        invisible="(route_type == 'user' and not assigned_user_id) or (route_type == 'group' and not call_group_id) or (route_type == 'ivr' and not ivr_menu_id)" />
            </field>
        </field>
    </record>

    <record id="view_signalwire_phone_number_form_inherit_click2call" model="ir.ui.view">
        <field name="name">signalwire.phone_number.form.inherit.click2call</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_configure_inbound_routing" type="object"
                        string="Configure Inbound Routing" class="btn-primary"
                        invisible="(route_type == 'user' and not assigned_user_id) or (route_type == 'group' and not call_group_id) or (route_type == 'ivr' and not ivr_menu_id)" />
            </xpath>
            <field name="sid" position="after">
                <field name="route_type" widget="radio" options="{'horizontal': true}" />
                <field name="assigned_user_id" invisible="route_type != 'user'" />
                <field name="call_group_id" invisible="route_type != 'group'" />
                <field name="ivr_menu_id" invisible="route_type != 'ivr'" />
                <field name="calendar_id" />
                <field name="after_hours_route_type" invisible="not calendar_id"
                       widget="radio" options="{'horizontal': true}" />
                <field name="after_hours_user_id"
                       invisible="not calendar_id or after_hours_route_type not in ('user', 'user_voicemail')" />
                <field name="after_hours_call_group_id"
                       invisible="not calendar_id or after_hours_route_type not in ('group', 'group_voicemail')" />
                <field name="after_hours_ivr_menu_id"
                       invisible="not calendar_id or after_hours_route_type != 'ivr'" />
            </field>
        </field>
    </record>

    <record id="view_signalwire_call_group_list" model="ir.ui.view">
        <field name="name">signalwire.call.group.list</field>
        <field name="model">signalwire.call.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="member_ids" widget="many2many_tags" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_call_group_form" model="ir.ui.view">
        <field name="name">signalwire.call.group.form</field>
        <field name="model">signalwire.call.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="member_ids" widget="many2many_tags" />
                        <field name="voicemail_mode" widget="radio" />
                        <field name="voicemail_user_id"
                               invisible="voicemail_mode != 'user'" />
                        <field name="voicemail_greeting_text"
                               invisible="voicemail_mode != 'group'" />
                        <field name="voicemail_greeting_filename" invisible="1" />
                        <field name="voicemail_greeting"
                               filename="voicemail_greeting_filename"
                               invisible="voicemail_mode != 'group'" />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_signalwire_call_group" model="ir.actions.act_window">
        <field name="name">Call Groups</field>
        <field name="res_model">signalwire.call.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_signalwire_call_group" name="Call Groups"
              parent="signalwire_voip.menu_signalwire_root"
              action="action_signalwire_call_group" sequence="20" />

</odoo>
