<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_list_inherit_click2call" model="ir.ui.view">
        <field name="name">signalwire.phone_number.list.inherit.click2call</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_list" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="call_flow_summary" />
                <field name="inbound_connected" widget="boolean_toggle" readonly="1" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_signalwire_phone_number_form_inherit_click2call" model="ir.ui.view">
        <field name="name">signalwire.phone_number.form.inherit.click2call</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_configure_inbound_routing" type="object"
                        string="Connect" class="btn-primary" invisible="inbound_connected" />
                <button name="%(action_signalwire_open_status)d" type="action"
                        string="Open / Closed" />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-warning d-flex align-items-center gap-3" role="alert"
                     invisible="inbound_connected">
                    <span class="flex-grow-1">
                        Calls to this number aren't connected to this Odoo yet, or were
                        connected before this screen kept track. Click Connect once; it's
                        safe to click again.
                    </span>
                    <button name="action_configure_inbound_routing" type="object"
                            string="Connect" class="btn-warning" />
                </div>
                <div class="alert alert-info d-flex align-items-center gap-3" role="alert"
                     invisible="not company_closed_early or not calendar_id">
                    <span class="flex-grow-1">
                        The phones are closed early, so this number is using its
                        outside-business-hours routing.
                    </span>
                    <button name="%(action_signalwire_open_status)d" type="action"
                            string="Reopen..." class="btn-info" />
                </div>
                <field name="company_closed_early" invisible="1" />
                <field name="inbound_connected" invisible="1" />
                <p class="lead mb-3"><field name="call_flow_summary" readonly="1" /></p>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Business Hours">
                    <field name="calendar_id"
                           placeholder="None: calls always go the same way" />
                </group>
                <group name="call_flow">
                    <group string="During business hours">
                        <field name="route_type" string="Calls go to" widget="radio" />
                        <field name="assigned_user_id" string="Person" invisible="route_type != 'user'" />
                        <field name="call_group_id" invisible="route_type != 'group'" />
                        <field name="ivr_menu_id" invisible="route_type != 'ivr'" />
                    </group>
                    <group string="Outside business hours" invisible="not calendar_id">
                        <field name="after_hours_route_type" string="Calls go to" widget="radio" />
                        <field name="after_hours_user_id" string="Person"
                               invisible="after_hours_route_type not in ('user', 'user_voicemail')" />
                        <field name="after_hours_call_group_id" string="Call Group"
                               invisible="after_hours_route_type not in ('group', 'group_voicemail')" />
                        <field name="after_hours_ivr_menu_id" string="IVR Menu"
                               invisible="after_hours_route_type != 'ivr'" />
                    </group>
                </group>
                <group string="On Hold (when the receptionist parks a caller)">
                    <field name="hold_message_text" />
                    <field name="hold_music_filename" invisible="1" />
                    <field name="hold_music" filename="hold_music_filename" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_signalwire_call_group_list" model="ir.ui.view">
        <field name="name">signalwire.call.group.list</field>
        <field name="model">signalwire.call.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="member_ids" widget="many2many_tags" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_signalwire_call_group_form" model="ir.ui.view">
        <field name="name">signalwire.call.group.form</field>
        <field name="model">signalwire.call.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="member_ids" widget="many2many_tags" />
                        <field name="voicemail_mode" widget="radio" />
                        <field name="voicemail_user_id"
                               invisible="voicemail_mode != 'user'" />
                        <field name="voicemail_greeting_text"
                               invisible="voicemail_mode != 'group'" />
                        <field name="voicemail_greeting_filename" invisible="1" />
                        <field name="voicemail_greeting"
                               filename="voicemail_greeting_filename"
                               invisible="voicemail_mode != 'group'" />
                        <separator string="Hold and Retry Ring" />
                        <field name="max_ring_attempts" />
                        <field name="hold_message_text"
                               invisible="not max_ring_attempts" />
                        <field name="hold_music_filename" invisible="1" />
                        <field name="hold_music" filename="hold_music_filename"
                               invisible="not max_ring_attempts" />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_signalwire_call_group" model="ir.actions.act_window">
        <field name="name">Call Groups</field>
        <field name="res_model">signalwire.call.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_signalwire_call_group" name="Call Groups"
              parent="signalwire_voip.menu_signalwire_section_call_flow"
              action="action_signalwire_call_group" sequence="20" />

</odoo>
