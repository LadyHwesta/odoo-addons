<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Phones: Open or Closed (the day/night switch) -->
    <record id="view_signalwire_open_status_form" model="ir.ui.view">
        <field name="name">signalwire.open.status.form</field>
        <field name="model">signalwire.open.status</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1" />
                <field name="is_closed" invisible="1" />
                <div class="alert alert-success" role="status" invisible="is_closed">
                    <strong><field name="status" readonly="1" /></strong>
                </div>
                <div class="alert alert-warning" role="status" invisible="not is_closed">
                    <strong><field name="status" readonly="1" /></strong>
                </div>
                <p class="text-muted">
                    Closing early sends calls to each number's outside-business-hours
                    routing (<field name="affected_count" readonly="1" class="d-inline" />
                    numbers with Business Hours set) until 4:00 AM tomorrow, then the
                    phones open as usual by themselves. Numbers without Business Hours
                    aren't affected.
                </p>
                <footer>
                    <button name="action_close_today" type="object"
                            string="Close for the Rest of Today" class="btn-primary"
                            invisible="is_closed" />
                    <button name="action_reopen" type="object"
                            string="Reopen Now" class="btn-primary"
                            invisible="not is_closed" />
                    <button string="Done" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_signalwire_open_status" model="ir.actions.act_window">
        <field name="name">Phones: Open or Closed</field>
        <field name="res_model">signalwire.open.status</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Extensions: one row per person, one screen for their whole phone setup -->
    <record id="view_users_signalwire_extension_list" model="ir.ui.view">
        <field name="name">res.users.signalwire.extension.list</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" />
                <field name="signalwire_has_softphone" widget="boolean" />
                <field name="signalwire_desk_phone_count" />
                <field name="signalwire_active_forward_id" string="Forwards To" />
                <field name="signalwire_voicemail_enabled" string="Voicemail" widget="boolean" />
                <field name="signalwire_ring_group_ids" string="Also Rings" widget="many2many_tags" />
                <field name="signalwire_call_state" string="Now" />
            </list>
        </field>
    </record>

    <record id="view_users_signalwire_extension_form" model="ir.ui.view">
        <field name="name">res.users.signalwire.extension.form</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_provision_signalwire_sip" type="object"
                            string="Set Up Softphone" class="btn-primary"
                            invisible="signalwire_sip_endpoint_id" />
                    <button name="action_release_signalwire_sip" type="object"
                            string="Remove Softphone"
                            invisible="not signalwire_sip_endpoint_id"
                            confirm="Remove this person's softphone? Calls to them stop ringing in Odoo until it's set up again." />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <field name="signalwire_sip_endpoint_id" invisible="1" />
                    <div class="alert alert-info" role="alert" invisible="signalwire_sip_endpoint_id">
                        No softphone yet. Set Up Softphone gives this person a phone in
                        their browser; desk phones, forwarding and voicemail come after.
                    </div>
                    <group invisible="not signalwire_sip_endpoint_id">
                        <group string="If they don't answer">
                            <field name="signalwire_forwarding_number_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="name" placeholder="e.g. Cell" />
                                    <field name="phone_number" placeholder="+15551234567" />
                                </list>
                            </field>
                            <field name="signalwire_active_forward_id" string="Forward To"
                                   options="{'no_create': True}" />
                            <field name="signalwire_ring_group_ids" string="Also Ring"
                                   widget="many2many_tags"
                                   domain="[('signalwire_sip_endpoint_id', '!=', False)]" />
                        </group>
                        <group string="Voicemail">
                            <field name="signalwire_voicemail_enabled" string="On" />
                            <field name="signalwire_voicemail_transcribe"
                                   invisible="not signalwire_voicemail_enabled" />
                            <field name="signalwire_voicemail_max_length"
                                   invisible="not signalwire_voicemail_enabled" />
                            <field name="signalwire_voicemail_beep"
                                   invisible="not signalwire_voicemail_enabled" />
                            <field name="signalwire_voicemail_greeting_text"
                                   invisible="not signalwire_voicemail_enabled" />
                            <field name="signalwire_voicemail_greeting_filename" invisible="1" />
                            <field name="signalwire_voicemail_greeting"
                                   filename="signalwire_voicemail_greeting_filename"
                                   invisible="not signalwire_voicemail_enabled" />
                        </group>
                    </group>
                    <group string="Desk Phones" invisible="not signalwire_sip_endpoint_id">
                        <field name="signalwire_desk_phone_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="name" placeholder="e.g. Front Desk" />
                                <field name="mac_address" placeholder="aa:bb:cc:dd:ee:ff" />
                                <field name="brand" />
                                <field name="provisioning_url" readonly="1" />
                                <button name="action_provision" type="object"
                                        string="Provision" class="btn-link"
                                        invisible="signalwire_sip_endpoint_id" />
                                <button name="action_release" type="object"
                                        string="Release" class="btn-link"
                                        invisible="not signalwire_sip_endpoint_id" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_signalwire_extensions" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'active_test': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_users_signalwire_extension_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_users_signalwire_extension_form')})]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No people yet</p>
            <p>Every internal user can have a softphone, desk phones, forwarding and voicemail.</p>
        </field>
    </record>

    <menuitem id="menu_signalwire_open_status" name="Open / Closed"
              parent="signalwire_voip.menu_signalwire_section_phones"
              action="action_signalwire_open_status" sequence="5"
              groups="group_signalwire_receptionist,base.group_system" />
    <menuitem id="menu_signalwire_extensions" name="Extensions"
              parent="signalwire_voip.menu_signalwire_root"
              action="action_signalwire_extensions" sequence="30"
              groups="base.group_erp_manager" />
    <menuitem id="menu_signalwire_business_hours" name="Business Hours"
              parent="signalwire_voip.menu_signalwire_section_call_flow"
              action="resource.action_resource_calendar_form" sequence="40" />

</odoo>
