<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="signalwire_callback_request_rule_user_own" model="ir.rule">
        <field name="name">Callback Request: requests for me, my call groups, or that I took</field>
        <field name="model_id" ref="model_signalwire_callback_request" />
        <field name="domain_force">[
            '|', '|',
            ('target_user_id', '=', user.id),
            ('target_group_id.member_ids', 'in', user.id),
            ('claimed_by_user_id', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="signalwire_callback_request_rule_receptionist_all" model="ir.rule">
        <field name="name">Callback Request: receptionists see every request</field>
        <field name="model_id" ref="model_signalwire_callback_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_signalwire_receptionist'))]" />
    </record>

</odoo>
