<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="signalwire_voicemail_rule_own" model="ir.rule">
        <field name="name">Voicemail: a plain user only sees/edits/deletes their own</field>
        <field name="model_id" ref="model_signalwire_voicemail" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="signalwire_voicemail_rule_group" model="ir.rule">
        <field name="name">Voicemail: a plain user also sees/edits/deletes their own call groups' shared ones</field>
        <field name="model_id" ref="model_signalwire_voicemail" />
        <field name="domain_force">[('call_group_id.member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

</odoo>
