<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="signalwire_call_group_company_rule" model="ir.rule">
        <field name="name">SignalWire Call Group: multi-company</field>
        <field name="model_id" ref="model_signalwire_call_group" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="signalwire_ivr_menu_company_rule" model="ir.rule">
        <field name="name">SignalWire IVR Menu: multi-company</field>
        <field name="model_id" ref="model_signalwire_ivr_menu" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>
