<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_close_finished_calls" model="ir.cron">
        <field name="name">VoIP: mark finished calls as ended</field>
        <field name="model_id" ref="model_signalwire_live_call" />
        <field name="state">code</field>
        <field name="code">model._cron_close_finished_calls()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_queue_tick" model="ir.cron">
        <field name="name">VoIP: offer waiting callers, enforce longest queue wait</field>
        <field name="model_id" ref="model_signalwire_live_call" />
        <field name="state">code</field>
        <field name="code">model._cron_queue_tick()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_alert_due_callbacks" model="ir.cron">
        <field name="name">VoIP: alert "callback when we open" requests once open</field>
        <field name="model_id" ref="model_signalwire_callback_request" />
        <field name="state">code</field>
        <field name="code">model._cron_alert_due_callbacks()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
