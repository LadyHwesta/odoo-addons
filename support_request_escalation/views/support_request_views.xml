<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="support_request_view_form" model="ir.ui.view">
        <field name="name">support.request.form</field>
        <field name="model">support.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_take" type="object" string="Take it" class="btn-primary"
                            invisible="not is_coordinator or state != 'new'"/>
                    <button name="action_solved" type="object" string="Solved here" class="btn-success"
                            invisible="not is_coordinator or state not in ('new', 'review')"/>
                    <button name="action_escalate" type="object" class="btn-primary"
                            string="Send to support"
                            invisible="not is_coordinator or not can_escalate or state == 'solved'"/>
                    <button name="action_escalate" type="object" string="Send to support anyway"
                            invisible="not is_coordinator or not can_escalate or state != 'solved'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="not is_coordinator or state not in ('solved', 'closed')"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state in ('closed', 'new')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,review,escalated,closed"/>
                </header>
                <sheet>
                    <field name="is_coordinator" invisible="1"/>
                    <field name="can_escalate" invisible="1"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="reference" readonly="1" invisible="reference == '/'"/></div>
                        <h1><field name="name" placeholder="e.g. The invoice won't print"
                                   readonly="state not in ('new', 'review')"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="urgency" widget="radio" readonly="state not in ('new', 'review')"/>
                            <field name="requester_id" invisible="not id"/>
                            <field name="coordinator_id" invisible="not coordinator_id"/>
                        </group>
                        <group>
                            <field name="page_title" invisible="not page_title"/>
                            <field name="page_url" widget="url" invisible="not page_url"/>
                            <field name="escalated_on" invisible="not escalated_on"/>
                            <field name="provider_name" invisible="state != 'escalated'" string="Sent to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened? Any error message? What did you expect?"
                           readonly="state not in ('new', 'review')"/>
                    <separator string="What were you trying to do?"/>
                    <field name="trying_to" nolabel="1" placeholder="e.g. Send last month's invoices to a customer"
                           readonly="state not in ('new', 'review')"/>
                    <field name="user_agent" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- What "Report a problem" opens: just the questions; the page is filled in for them. -->
    <record id="support_request_view_form_report" model="ir.ui.view">
        <field name="name">support.request.form.report</field>
        <field name="model">support.request</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Report a problem">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. The invoice won't print" required="1"/>
                        <field name="description" placeholder="What happened? Any error message? What did you expect?"/>
                        <field name="trying_to" placeholder="e.g. Send last month's invoices to a customer"/>
                        <field name="urgency" widget="radio" options="{'horizontal': true}"/>
                        <field name="page_title" invisible="not page_title"/>
                        <field name="page_url" invisible="1"/>
                        <field name="user_agent" invisible="1"/>
                    </group>
                    <p class="text-muted mb-0">
                        It goes to the people here who look after support. You'll see their answer under
                        Support › My Requests, and add a screenshot there if it helps.
                    </p>
                </sheet>
                <footer>
                    <button string="Send" class="btn-primary" special="save"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="support_request_view_list" model="ir.ui.view">
        <field name="name">support.request.list</field>
        <field name="model">support.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="urgency == 'high' and state in ('new', 'review')"
                  decoration-muted="state in ('solved', 'closed')">
                <field name="reference"/>
                <field name="name"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="urgency"/>
                <field name="create_date" string="Reported"/>
                <field name="coordinator_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'new'"
                       decoration-warning="state in ('review', 'escalated')" decoration-success="state == 'solved'"/>
            </list>
        </field>
    </record>

    <record id="support_request_view_search" model="ir.ui.view">
        <field name="name">support.request.search</field>
        <field name="model">support.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Request" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="requester_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'review', 'escalated'))]"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="escalated" string="Sent to support" domain="[('state', '=', 'escalated')]"/>
                <filter name="mine" string="Reported by me" domain="[('requester_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_requester" string="Reported by" context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_support_request_report" model="ir.actions.act_window">
        <field name="name">Report a problem</field>
        <field name="res_model">support.request</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="support_request_view_form_report"/>
        <field name="target">new</field>
    </record>

    <record id="action_support_request_mine" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">support.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No requests yet</p>
            <p>When something in Odoo isn't working, use <strong>Report a problem</strong> in your user
            menu (top right). The people here who look after support will pick it up.</p>
        </field>
    </record>

    <record id="action_support_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">support.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting</p>
            <p>Requests people send with <strong>Report a problem</strong> appear here. Take one, solve it,
            or send it to your Odoo provider's support.</p>
        </field>
    </record>

    <menuitem id="menu_support_root" name="Support" sequence="95"
              web_icon="support_request_escalation,static/description/icon.png"/>
    <menuitem id="menu_support_mine" name="My Requests" parent="menu_support_root"
              action="action_support_request_mine" sequence="1"/>
    <menuitem id="menu_support_all" name="All Requests" parent="menu_support_root"
              action="action_support_request_all" sequence="2"
              groups="group_support_coordinator"/>
</odoo>
