<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_calendar_event_form_documents" model="ir.ui.view">
        <field name="name">calendar.event.form.documents</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <page name="notes" position="before">
                <page name="documents" string="Documents">
                    <field name="document_ids" widget="one2many"
                           context="{'default_res_model': 'calendar.event', 'default_res_id': id}">
                        <list name="documents" create="1" delete="1" no_open="1">
                            <field name="name" string="File" />
                            <field name="meeting_private" widget="boolean_toggle" />
                            <field name="file_size" string="Size" widget="binary_size" optional="show" />
                            <field name="create_uid" string="Added By" optional="hide" />
                            <field name="create_date" string="Added" optional="show" />
                            <button name="action_calendar_download" type="object" string="Download"
                                    icon="fa-download" class="btn-link" />
                        </list>
                        <form>
                            <group>
                                <field name="datas" string="File" filename="name" required="1" />
                                <field name="name" string="Name" />
                                <field name="meeting_private" />
                            </group>
                        </form>
                    </field>
                    <group>
                        <field name="documents_in_invitations" />
                    </group>
                    <p class="text-muted small">
                        Private documents stay here for your team: they aren't sent with
                        invitations or listed in the meeting's video call.
                    </p>
                </page>
            </page>
        </field>
    </record>

    <!-- The pop-up when you click a meeting in the calendar. -->
    <record id="view_calendar_event_calendar_documents" model="ir.ui.view">
        <field name="name">calendar.event.calendar.documents</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar" />
        <field name="arch" type="xml">
            <field name="alarm_ids" position="before">
                <field name="document_ids" invisible="not document_ids" widget="many2many_tags"
                       options="{'icon': 'fa fa-paperclip'}" />
            </field>
        </field>
    </record>

</odoo>
