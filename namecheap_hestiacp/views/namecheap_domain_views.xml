<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_namecheap_domain_form_inherit_hestiacp" model="ir.ui.view">
        <field name="name">namecheap.domain.form.inherit.hestiacp</field>
        <field name="model">namecheap.domain</field>
        <field name="inherit_id" ref="namecheap_domains.view_namecheap_domain_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_deploy_to_hestiacp" type="object"
                        string="Deploy to HestiaCP" class="btn-primary"
                        invisible="not hestiacp_account_id or hestiacp_deployed_on" />
                <button name="action_fetch_dkim_record" type="object"
                        string="Fetch DKIM Record"
                        invisible="not hestiacp_deployed_on" />
            </xpath>
            <group name="namecheap_domain_details" position="after">
                <group string="HestiaCP">
                    <field name="hestiacp_account_id" />
                    <field name="manage_dns_via_hestiacp"
                           invisible="not hestiacp_account_id" />
                    <field name="hestiacp_deployed_on" readonly="1" />
                </group>
                <group string="DKIM (copy to whatever's authoritative for DNS)"
                       invisible="not dkim_record_name">
                    <field name="dkim_record_name" readonly="1" />
                    <field name="dkim_record_value" readonly="1" />
                </group>
            </group>
        </field>
    </record>

</odoo>
