<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmarc_domain_view_list" model="ir.ui.view">
        <field name="name">dmarc.domain.list</field>
        <field name="model">dmarc.domain</field>
        <field name="arch" type="xml">
            <list decoration-danger="failing_sender_count &gt; 0">
                <field name="name"/>
                <field name="current_policy"/>
                <field name="message_total"/>
                <field name="pass_rate" widget="progressbar"/>
                <field name="failing_sender_count"/>
                <field name="report_count"/>
                <field name="last_report_date"/>
            </list>
        </field>
    </record>

    <record id="dmarc_domain_view_form" model="ir.ui.view">
        <field name="name">dmarc.domain.form</field>
        <field name="model">dmarc.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="example.com"/></h1></div>
                    <group>
                        <group>
                            <field name="current_policy"/>
                            <field name="last_report_date"/>
                        </group>
                        <group>
                            <field name="message_total"/>
                            <field name="pass_rate" widget="progressbar"/>
                            <field name="failing_sender_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings" name="findings">
                            <field name="findings_html" readonly="1"/>
                        </page>
                        <page string="DNS setup" name="dns">
                            <p>Publish this as a TXT record named <code>_dmarc</code> on the domain:</p>
                            <field name="suggested_record" readonly="1" widget="CopyClipboardChar"/>
                            <div invisible="not permission_record">
                                <p class="mt-3">Your reporting address is on another domain, so that domain must
                                    also publish this record, or providers won't send reports there. A wildcard
                                    record, <code>*._report._dmarc</code> with <code>v=DMARC1</code>, covers every
                                    domain at once.</p>
                                <field name="permission_record" readonly="1" widget="CopyClipboardChar"/>
                            </div>
                        </page>
                        <page string="Reports" name="reports">
                            <field name="report_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dmarc_domain_view_search" model="ir.ui.view">
        <field name="name">dmarc.domain.search</field>
        <field name="model">dmarc.domain</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dmarc_domain" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">dmarc.domain</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No domains yet</p>
            <p>Domains appear here by themselves when their first report arrives. You can also add one
                to get its DNS records before any reports exist.</p>
        </field>
    </record>
</odoo>
