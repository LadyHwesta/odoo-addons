<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmarc_report_view_list" model="ir.ui.view">
        <field name="name">dmarc.report.list</field>
        <field name="model">dmarc.report</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'error'">
                <field name="date_end"/>
                <field name="domain_id"/>
                <field name="org_name"/>
                <field name="policy_p"/>
                <field name="message_count" sum="Total"/>
                <field name="pass_count" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="dmarc_report_view_form" model="ir.ui.view">
        <field name="name">dmarc.report.form</field>
        <field name="model">dmarc.report</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'error'">
                        <field name="error"/>
                    </div>
                    <group invisible="state == 'error'">
                        <group>
                            <field name="domain_id"/>
                            <field name="org_name"/>
                            <field name="org_email"/>
                            <field name="external_id"/>
                        </group>
                        <group>
                            <field name="date_begin"/>
                            <field name="date_end"/>
                            <field name="policy_p"/>
                            <field name="policy_pct"/>
                            <field name="message_count"/>
                            <field name="pass_count"/>
                        </group>
                    </group>
                    <field name="record_ids" invisible="state == 'error'" readonly="1">
                        <list decoration-danger="not passed">
                            <field name="sender_label"/>
                            <field name="source_ip"/>
                            <field name="count"/>
                            <field name="passed" widget="boolean"/>
                            <field name="dkim_aligned"/>
                            <field name="spf_aligned"/>
                            <field name="disposition"/>
                            <field name="dkim_results" optional="hide"/>
                            <field name="spf_results" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dmarc_report_view_search" model="ir.ui.view">
        <field name="name">dmarc.report.search</field>
        <field name="model">dmarc.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="domain_id"/>
                <field name="org_name"/>
                <filter name="errors" string="Couldn't read" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="group_domain" string="Domain" context="{'group_by': 'domain_id'}"/>
                <filter name="group_org" string="Reported by" context="{'group_by': 'org_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_dmarc_report" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">dmarc.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reports read yet</p>
            <p>Set up an Incoming Mail Server for your reporting mailbox, set to create DMARC Reports.</p>
        </field>
    </record>
</odoo>
