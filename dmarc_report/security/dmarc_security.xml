<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_dmarc" model="res.groups.privilege">
        <field name="name">DMARC</field>
        <field name="sequence">90</field>
    </record>
    <record id="group_dmarc_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_dmarc"/>
    </record>
    <record id="group_dmarc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_dmarc"/>
        <field name="implied_ids" eval="[(4, ref('group_dmarc_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
