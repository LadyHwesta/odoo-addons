<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_sms_compose_form" model="ir.ui.view">
        <field name="name">signalwire.sms.compose.form</field>
        <field name="model">signalwire.sms.compose</field>
        <field name="arch" type="xml">
            <form>
                <field name="partner_id" invisible="1" />
                <group>
                    <field name="phone_number_id" />
                    <field name="to" />
                    <field name="body" />
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Send" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
