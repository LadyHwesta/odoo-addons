<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_form_inherit_sms" model="ir.ui.view">
        <field name="name">signalwire.phone_number.form.inherit.sms</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="sms_webhook_url"
                       placeholder="https://customer-system.example.com/webhook" />
            </field>
            <sheet position="inside">
                <notebook>
                    <page string="Messages" name="messages">
                        <field name="sms_ids" readonly="1">
                            <list>
                                <field name="create_date" />
                                <field name="direction" />
                                <field name="from_number" />
                                <field name="to_number" />
                                <field name="body" />
                                <field name="state" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

</odoo>
