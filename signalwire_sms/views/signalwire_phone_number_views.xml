<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_phone_number_form_inherit_sms" model="ir.ui.view">
        <field name="name">signalwire.phone_number.form.inherit.sms</field>
        <field name="model">signalwire.phone_number</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_phone_number_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_configure_inbound_sms" type="object"
                        string="Connect Incoming Texts"
                        help="Have texts sent to this number come into Odoo, so HELP and STOP get their replies." />
            </xpath>
            <field name="company_id" position="after">
                <field name="sms_webhook_url"
                       placeholder="https://customer-system.example.com/webhook" />
                <field name="sms_stop_reply_text" />
                <field name="sms_start_reply_text" />
                <field name="sms_help_reply_text" />
            </field>
            <sheet position="inside">
                <notebook>
                    <page string="Messages" name="messages">
                        <field name="sms_ids" readonly="1">
                            <list>
                                <field name="create_date" />
                                <field name="direction" />
                                <field name="from_number" />
                                <field name="to_number" />
                                <field name="body" />
                                <field name="state" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

</odoo>
