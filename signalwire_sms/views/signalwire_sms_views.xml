<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_sms_list" model="ir.ui.view">
        <field name="name">signalwire.sms.list</field>
        <field name="model">signalwire.sms</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" />
                <field name="direction" />
                <field name="phone_number_id" />
                <field name="from_number" />
                <field name="to_number" />
                <field name="body" />
                <field name="partner_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_signalwire_sms" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">signalwire.sms</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
