<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_sms_list" model="ir.ui.view">
        <field name="name">signalwire.sms.list</field>
        <field name="model">signalwire.sms</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" string="When" />
                <field name="direction" widget="badge"
                       decoration-info="direction == 'inbound'"
                       decoration-muted="direction == 'outbound'" />
                <field name="partner_id" string="Contact" />
                <field name="other_number" string="Their Number" />
                <field name="body" string="Message" />
                <field name="state" string="Status" widget="badge" optional="show" />
                <field name="phone_number_id" string="Our Number" optional="hide" />
                <field name="from_number" optional="hide" />
                <field name="to_number" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_signalwire_sms" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">signalwire.sms</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
