<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_signalwire_subproject_form_inherit_sms" model="ir.ui.view">
        <field name="name">signalwire.subproject.form.inherit.sms</field>
        <field name="model">signalwire.subproject</field>
        <field name="inherit_id" ref="signalwire_voip.view_signalwire_subproject_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_issue_customer_token" type="object"
                        string="Issue Customer Access Token"
                        invisible="not account_sid" />
            </xpath>
            <page name="phone_numbers" position="after">
                <page string="Customer Access Tokens" name="customer_tokens">
                    <field name="customer_token_ids">
                        <list editable="bottom" create="0">
                            <field name="name" readonly="1" />
                            <field name="token" readonly="1" />
                            <field name="active" column_invisible="1" />
                            <button name="action_revoke" type="object"
                                    string="Revoke" class="btn-danger"
                                    invisible="not active" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
