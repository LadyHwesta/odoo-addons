<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_home_sms" name="Portal home: SMS"
              customize_show="True" inherit_id="portal.portal_my_home" priority="55">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True" />
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/folder.svg'" />
                <t t-set="title">SMS</t>
                <t t-set="url" t-value="'/my/sms'" />
                <t t-set="text">Your SignalWire number(s), messages, and access</t>
                <t t-set="placeholder_count" t-value="'signalwire_number_count'" />
            </t>
        </div>
    </template>

    <template id="portal_my_sms" name="My SMS">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">SMS</h3>

            <t t-if="not numbers">
                <p class="alert alert-info">You don't have an SMS number with us yet.</p>
            </t>

            <t t-foreach="numbers.subproject_id" t-as="subproject">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 t-esc="subproject.name" />

                        <t t-foreach="numbers.filtered(lambda n: n.subproject_id == subproject)" t-as="number">
                            <h6 class="mt-3" t-esc="number.name" />

                            <table class="table table-sm">
                                <tbody>
                                    <tr t-foreach="number.sms_ids[:20]" t-as="sms">
                                        <td style="width: 8em;">
                                            <span t-if="sms.direction == 'outbound'"
                                                  class="badge text-bg-primary">Sent</span>
                                            <span t-else="" class="badge text-bg-secondary">Received</span>
                                        </td>
                                        <td t-esc="sms.direction == 'outbound' and sms.to_number or sms.from_number" />
                                        <td t-esc="sms.body" />
                                        <td t-esc="sms.create_date" />
                                    </tr>
                                </tbody>
                            </table>

                            <form t-attf-action="/my/sms/send" method="post" class="row g-2 mb-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                <input type="hidden" name="phone_number_id" t-att-value="number.id" />
                                <div class="col-md-3">
                                    <input type="text" name="to" class="form-control"
                                           placeholder="To (e.g. +15551234567)" required="required" />
                                </div>
                                <div class="col-md-6">
                                    <input type="text" name="body" class="form-control"
                                           placeholder="Message" required="required" />
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100">Send</button>
                                </div>
                            </form>

                            <details class="mb-3">
                                <summary>Forward incoming texts to my own system</summary>
                                <form t-attf-action="/my/sms/webhook" method="post" class="row g-2 mt-2">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <input type="hidden" name="phone_number_id" t-att-value="number.id" />
                                    <div class="col-md-9">
                                        <input type="url" name="sms_webhook_url" class="form-control"
                                               t-att-value="number.sms_webhook_url"
                                               placeholder="https://your-system.example.com/webhook" />
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-secondary w-100">Save</button>
                                    </div>
                                </form>
                            </details>
                        </t>

                        <hr />
                        <h6>API Access</h6>
                        <p class="text-muted">
                            Prefer to integrate SMS into your own system directly? Issue
                            yourself a SignalWire API token below - it works with any
                            Twilio-compatible library, authenticating with this
                            Account SID and the token as the password:
                            <code t-esc="subproject.account_sid" />
                        </p>
                        <p class="text-muted small">
                            <strong>Note:</strong> "Revoke" removes a token from the list
                            below, but has not been confirmed to actually stop that token
                            from working - if you need a credential fully cut off, contact
                            us directly rather than relying on Revoke alone.
                        </p>
                        <table class="table table-sm" t-if="subproject.customer_token_ids">
                            <tbody>
                                <tr t-foreach="subproject.customer_token_ids.filtered('active')" t-as="token">
                                    <td t-esc="token.name" />
                                    <td><code t-esc="token.token" /></td>
                                    <td>
                                        <form t-attf-action="/my/sms/token/revoke" method="post">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()" />
                                            <input type="hidden" name="token_id" t-att-value="token.id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Revoke</button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <form t-attf-action="/my/sms/token/issue" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <input type="hidden" name="phone_number_id"
                                   t-att-value="numbers.filtered(lambda n: n.subproject_id == subproject)[:1].id" />
                            <button type="submit" class="btn btn-secondary">Issue New Token</button>
                        </form>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
