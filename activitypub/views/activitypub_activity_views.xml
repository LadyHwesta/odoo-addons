<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Activities (the outbox / inbound log) -->
    <record id="view_activitypub_activity_list" model="ir.ui.view">
        <field name="name">activitypub.activity.list</field>
        <field name="model">activitypub.activity</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="When"/>
                <field name="direction"/>
                <field name="activity_type"/>
                <field name="actor_id"/>
                <field name="remote_actor_uri" optional="hide"/>
                <field name="state"
                       decoration-success="state in ('delivered','processed')"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'ignored'"
                       widget="badge"/>
                <field name="uri" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_activitypub_activity_form" model="ir.ui.view">
        <field name="name">activitypub.activity.form</field>
        <field name="model">activitypub.activity</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="activity_type"/>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="actor_id"/>
                            <field name="remote_actor_uri"/>
                            <field name="object_id"/>
                            <field name="object_uri"/>
                            <field name="uri"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" widget="json"/>
                        </page>
                        <page string="Deliveries" name="deliveries"
                              invisible="direction != 'out'">
                            <field name="delivery_ids">
                                <list>
                                    <field name="inbox_url"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'delivered'"
                                           decoration-danger="state == 'failed'"
                                           decoration-warning="state == 'retry'"/>
                                    <field name="attempts"/>
                                    <field name="next_attempt"/>
                                    <field name="delivered_at"/>
                                    <field name="last_error"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_activitypub_activity_search" model="ir.ui.view">
        <field name="name">activitypub.activity.search</field>
        <field name="model">activitypub.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="actor_id"/>
                <field name="remote_actor_uri"/>
                <filter name="outbound" string="Outbound" domain="[('direction', '=', 'out')]"/>
                <filter name="inbound" string="Inbound" domain="[('direction', '=', 'in')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'activity_type'}"/>
                <filter name="group_actor" string="Local Actor" context="{'group_by': 'actor_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_activitypub_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">activitypub.activity</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_outbound': 1}</field>
    </record>

    <!-- Followers -->
    <record id="view_activitypub_follower_list" model="ir.ui.view">
        <field name="name">activitypub.follower.list</field>
        <field name="model">activitypub.follower</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Since"/>
                <field name="actor_id"/>
                <field name="follower_uri"/>
                <field name="state" widget="badge"/>
                <field name="shared_inbox_url" optional="hide"/>
                <field name="inbox_url" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_activitypub_follower" model="ir.actions.act_window">
        <field name="name">Followers</field>
        <field name="res_model">activitypub.follower</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Delivery queue -->
    <record id="view_activitypub_delivery_list" model="ir.ui.view">
        <field name="name">activitypub.delivery.list</field>
        <field name="model">activitypub.delivery</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Queued"/>
                <field name="activity_id"/>
                <field name="inbox_url"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'retry'"/>
                <field name="attempts"/>
                <field name="next_attempt"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="action_activitypub_delivery" model="ir.actions.act_window">
        <field name="name">Delivery Queue</field>
        <field name="res_model">activitypub.delivery</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Objects (local renders + stored remote replies) -->
    <record id="view_activitypub_object_list" model="ir.ui.view">
        <field name="name">activitypub.object.list</field>
        <field name="model">activitypub.object</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="published"/>
                <field name="object_type"/>
                <field name="local"/>
                <field name="actor_id" optional="show"/>
                <field name="in_reply_to_uri" optional="hide"/>
                <field name="reply_count" string="Replies"/>
                <field name="like_count" string="Likes"/>
                <field name="announce_count" string="Boosts"/>
                <field name="deleted"/>
                <field name="uri" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_activitypub_object_form" model="ir.ui.view">
        <field name="name">activitypub.object.form</field>
        <field name="model">activitypub.object</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="object_type"/>
                            <field name="local"/>
                            <field name="deleted"/>
                            <field name="published"/>
                        </group>
                        <group>
                            <field name="actor_id"/>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="in_reply_to_uri"/>
                            <field name="uri"/>
                        </group>
                    </group>
                    <group>
                        <field name="reply_count"/>
                        <field name="like_count"/>
                        <field name="announce_count"/>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" widget="json"/>
                        </page>
                        <page string="Reactions" name="reactions">
                            <field name="interaction_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="interaction_type"/>
                                    <field name="actor_uri"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_activitypub_object_search" model="ir.ui.view">
        <field name="name">activitypub.object.search</field>
        <field name="model">activitypub.object</field>
        <field name="arch" type="xml">
            <search>
                <field name="uri"/>
                <field name="actor_id"/>
                <field name="in_reply_to_uri"/>
                <filter name="local" string="Local" domain="[('local', '=', True)]"/>
                <filter name="remote" string="Remote" domain="[('local', '=', False)]"/>
                <filter name="replies" string="Replies" domain="[('in_reply_to_uri', '!=', False)]"/>
                <filter name="deleted" string="Deleted" domain="[('deleted', '=', True)]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'object_type'}"/>
                <filter name="group_actor" string="Actor" context="{'group_by': 'actor_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_activitypub_object" model="ir.actions.act_window">
        <field name="name">Objects</field>
        <field name="res_model">activitypub.object</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_local': 1}</field>
    </record>

</odoo>
