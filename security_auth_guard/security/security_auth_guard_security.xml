<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_security" model="ir.module.category">
        <field name="name">Security</field>
        <field name="sequence">5</field>
    </record>

    <record id="privilege_security" model="res.groups.privilege">
        <field name="name">Security</field>
        <field name="category_id" ref="module_category_security" />
        <field name="sequence">10</field>
    </record>

    <record id="group_security_officer" model="res.groups">
        <field name="name">Security Officer</field>
        <field name="privilege_id" ref="privilege_security" />
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]" />
        <field name="comment">Full access to the security event log, IP
            rules, and login-attempt history. Granted to admins by
            default; never grant this to a portal or public user.</field>
    </record>

</odoo>
