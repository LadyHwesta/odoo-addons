<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_security_auth_guard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.security.auth.guard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Security" string="Security" name="security_auth_guard" groups="base.group_system">
                    <block title="Login Cooldown" name="security_auth_guard_settings">
                        <setting id="login_cooldown_after_setting" help="Failed login attempts from one IP before it's put on cooldown.">
                            <field name="login_cooldown_after" />
                        </setting>
                        <setting id="login_cooldown_duration_setting" help="How long the cooldown lasts, in seconds.">
                            <field name="login_cooldown_duration" />
                        </setting>
                        <setting id="cooldown_escalate_threshold_setting" help="Cooldown triggers from one IP in the window below before it's permanently blocked. Use -1 to turn off automatic blocking.">
                            <field name="cooldown_escalate_threshold" />
                        </setting>
                        <setting id="cooldown_escalate_window_hours_setting" help="The escalation window, in hours.">
                            <field name="cooldown_escalate_window_hours" />
                        </setting>
                        <setting id="alert_phone_number_setting" help="Only used if a SignalWire module is also installed - leave blank to disable SMS alerts on critical events.">
                            <field name="alert_phone_number" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
