<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="security_event_view_form" model="ir.ui.view">
        <field name="name">security.event.form</field>
        <field name="model">security.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark Reviewed"
                            invisible="state == 'reviewed'" />
                    <button name="action_escalate_to_block" type="object"
                            string="Block This IP" class="btn-danger"
                            invisible="not source_ip or state == 'escalated'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_type" />
                            <field name="severity" />
                            <field name="source_ip" />
                            <field name="login" />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="model_name" />
                            <field name="res_id" />
                        </group>
                    </group>
                    <field name="detail" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="security_event_view_list" model="ir.ui.view">
        <field name="name">security.event.list</field>
        <field name="model">security.event</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'">
                <field name="create_date" />
                <field name="event_type" />
                <field name="severity" widget="badge" />
                <field name="source_ip" />
                <field name="login" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="security_event_view_search" model="ir.ui.view">
        <field name="name">security.event.search</field>
        <field name="model">security.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_ip" />
                <field name="login" />
                <filter name="new" string="New" domain="[('state', '=', 'new')]" />
                <filter name="critical" string="Critical"
                        domain="[('severity', '=', 'critical')]" />
                <group>
                    <filter name="group_by_type" string="Type"
                            context="{'group_by': 'event_type'}" />
                    <filter name="group_by_severity" string="Severity"
                            context="{'group_by': 'severity'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="security_event_action" model="ir.actions.act_window">
        <field name="name">Security Events</field>
        <field name="res_model">security.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
    </record>
</odoo>
