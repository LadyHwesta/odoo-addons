<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="security_ip_rule_view_list" model="ir.ui.view">
        <field name="name">security.ip_rule.list</field>
        <field name="model">security.ip_rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="ip_or_cidr" />
                <field name="action" widget="badge" />
                <field name="reason" />
                <field name="expires_at" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="security_ip_rule_view_form" model="ir.ui.view">
        <field name="name">security.ip_rule.form</field>
        <field name="model">security.ip_rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="ip_or_cidr" />
                        <field name="action" />
                        <field name="reason" />
                        <field name="expires_at" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="security_ip_rule_action" model="ir.actions.act_window">
        <field name="name">IP Rules</field>
        <field name="res_model">security.ip_rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
