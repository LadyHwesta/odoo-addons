<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_home_support_call" name="Support Call"
              inherit_id="portal.portal_my_home" customize_show="True" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-if="request.env.user.partner_id.signalwire_portal_support_tier != 'none'"
               t-set="portal_service_category_enable" t-value="True" />
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-if="request.env.user.partner_id.signalwire_portal_support_tier != 'none'">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/web/static/img/spin.svg'" />
                    <t t-set="title">Talk to Support</t>
                    <t t-set="url" t-value="'/my/support/call'" />
                    <t t-set="text">Request a callback from our support team</t>
                    <t t-set="placeholder_count" t-value="'signalwire_callback_request_count'" />
                </t>
            </t>
        </div>
    </template>

    <template id="portal_support_call" name="Support Call">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False" />
            <div class="row">
                <div class="col-12 col-lg-6">
                    <h3>Request a Callback</h3>
                    <p class="text-muted">
                        Leave your number and a quick note - someone from our
                        support team will call you back.
                    </p>
                    <form action="/my/support/call/submit" method="post"
                          class="mb-4">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()" />
                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" name="phone_number" class="form-control"
                                   t-att-value="partner.phone" required="required" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note (optional)</label>
                            <textarea name="note" class="form-control" rows="3" />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            Request Callback
                        </button>
                    </form>
                </div>
                <div class="col-12 col-lg-6" t-if="requests">
                    <h3>Your Recent Requests</h3>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Number</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="requests" t-as="req">
                                <td t-esc="req.create_date" />
                                <td t-esc="req.phone_number" />
                                <td t-esc="req.state" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

</odoo>
