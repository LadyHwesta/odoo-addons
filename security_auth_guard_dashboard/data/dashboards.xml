<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="dashboard_group_security" model="spreadsheet.dashboard.group">
        <field name="name">Security</field>
        <field name="sequence">1</field>
    </record>

    <record id="dashboard_threats" model="spreadsheet.dashboard">
        <field name="name">Threats</field>
        <field name="spreadsheet_binary_data" type="base64" file="security_auth_guard_dashboard/data/files/threat_dashboard.json" />
        <field name="dashboard_group_id" ref="dashboard_group_security" />
        <field name="group_ids" eval="[Command.set([ref('security_auth_guard.group_security_officer')])]" />
        <field name="sequence">10</field>
        <field name="is_published" eval="True" />
    </record>

    <record id="action_threat_dashboard" model="ir.actions.client">
        <field name="name">Threats</field>
        <field name="tag">action_spreadsheet_dashboard</field>
        <field name="params" eval="{'dashboard_id': ref('dashboard_threats')}" />
    </record>

    <menuitem id="menu_security_threats"
              name="Threats"
              parent="security_auth_guard.menu_security_root"
              action="action_threat_dashboard"
              sequence="0" />
</odoo>
