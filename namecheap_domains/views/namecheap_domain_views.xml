<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_namecheap_domain_form" model="ir.ui.view">
        <field name="name">namecheap.domain.form</field>
        <field name="model">namecheap.domain</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_update_nameservers" type="object"
                            string="Update Nameservers" invisible="not nameservers" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="example.com" /></h1>
                    </div>
                    <group name="namecheap_domain_details">
                        <group>
                            <field name="server_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="registered_on" />
                            <field name="expires_on" />
                        </group>
                    </group>
                    <group string="DNS">
                        <field name="nameservers"
                               placeholder="Leave blank for Namecheap's own default DNS" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_namecheap_domain_list" model="ir.ui.view">
        <field name="name">namecheap.domain.list</field>
        <field name="model">namecheap.domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="expires_on" />
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'" />
            </list>
        </field>
    </record>

    <record id="action_namecheap_domain" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">namecheap.domain</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
