<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gig_gear_item_view_list" model="ir.ui.view">
        <field name="name">gig.gear.item.list</field>
        <field name="model">gig.gear.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gig_gear_item_view_search" model="ir.ui.view">
        <field name="name">gig.gear.item.search</field>
        <field name="model">gig.gear.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gig_gear_item" model="ir.actions.act_window">
        <field name="name">Gear</field>
        <field name="res_model">gig.gear.item</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the gear you take to gigs</p>
            <p>Speakers, lights, mics, cables... and how many of each you own. Then say on each package
               which gear it needs, and every booked gig gets its packing checklist.</p>
        </field>
    </record>

    <menuitem id="menu_gig_gear_item" name="Gear" parent="sale.menu_sales_config"
              action="action_gig_gear_item" sequence="20"/>

</odoo>
