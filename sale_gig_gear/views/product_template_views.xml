<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_gig_gear" model="ir.ui.view">
        <field name="name">product.template.form.gig.gear</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_gig_booking.product_template_form_gig"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='gigs']" position="inside">
                <separator string="Gig Gear"/>
                <div name="gig_gear">
                    <p class="text-muted">Gear a gig with this package or add-on needs. It's added to the
                        gig's packing checklist when the gig is booked.</p>
                    <field name="gig_gear_default_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="gear_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
