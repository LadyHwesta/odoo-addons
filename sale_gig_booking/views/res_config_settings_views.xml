<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_gig" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gig</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Gig Bookings" name="gig_booking_setting_container">
                    <setting id="gig_buffer_hours_setting"
                             help="Bookings closer than this count as a double booking (setup, travel, pack-down).">
                        <field name="gig_buffer_hours" widget="float_time"/>
                    </setting>
                    <setting id="gig_balance_days_setting"
                             help="A to-do to invoice the balance appears this many days before each gig.">
                        <field name="gig_balance_days"/>
                    </setting>
                    <setting id="gig_min_hours_setting"
                             help="Products set to bill the gig's hours never bill fewer than this.">
                        <field name="gig_min_hours" widget="float_time"/>
                    </setting>
                    <setting id="gig_tz_setting" help="Gig times are entered and shown in this time zone.">
                        <field name="gig_tz"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
