<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_gig" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gig</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Gig Bookings" name="gig_booking_setting_container">
                    <setting id="gig_buffer_hours_setting"
                             help="Bookings closer than this count as a double booking (setup, travel, pack-down).">
                        <field name="gig_buffer_hours" widget="float_time"/>
                    </setting>
                    <setting id="gig_balance_days_setting"
                             help="A to-do to invoice the balance appears this many days before each gig.">
                        <field name="gig_balance_days"/>
                    </setting>
                    <setting id="gig_min_hours_setting"
                             help="Products set to bill the gig's hours never bill fewer than this.">
                        <field name="gig_min_hours" widget="float_time"/>
                    </setting>
                    <setting id="gig_tz_setting" help="Gig times are entered and shown in this time zone.">
                        <field name="gig_tz"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <record id="res_config_settings_view_form_gig_website" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gig.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Booking Requests" id="gig_booking_website_settings" invisible="not website_id">
                    <setting id="gig_booking_team_setting"
                             help="The sales team this website's Book a Date requests go to. The lead, and any quote made from it, belong to that team's company, so they use that company's settings and agreement terms.">
                        <field name="website_gig_booking_team_id"
                               domain="[('company_id', 'in', [website_company_id, False])]"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
