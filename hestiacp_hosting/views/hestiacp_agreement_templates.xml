<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="hestiacp_agreement_page" name="Hosting Service Agreement">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5" style="max-width: 800px;">
                    <t t-if="agreement">
                        <h1 t-out="agreement.name" />
                        <p class="text-muted">Version <span t-out="agreement.version" /></p>
                        <div t-field="agreement.body_html" />
                        <form action="/hosting/agreement/accept" method="post" class="mt-4 border-top pt-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <input type="hidden" name="redirect" t-att-value="redirect" />
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" required="required"
                                       id="hestiacp_aup_accept" name="accept" value="1" />
                                <label class="form-check-label" for="hestiacp_aup_accept">
                                    I have read and agree to the Hosting Service Agreement above,
                                    including the acceptable use, anti-spam, and unsubscribe
                                    requirements.
                                </label>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                I Agree - Continue to Payment
                            </button>
                            <a t-att-href="redirect" class="btn btn-link">Cancel</a>
                        </form>
                    </t>
                    <div t-else="" class="alert alert-warning" role="alert">
                        No Hosting Service Agreement has been configured yet. Please contact us
                        before continuing.
                        <a t-att-href="redirect">Back</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
