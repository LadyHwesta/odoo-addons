<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_product_template_form_hestiacp" model="ir.ui.view">
        <field name="name">product.template.form.hestiacp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hosting Package" name="hestiacp"
                      invisible="not is_hosting_package">
                    <group>
                        <field name="is_hosting_package" />
                    </group>
                    <group invisible="not is_hosting_package">
                        <group string="HestiaCP">
                            <field name="hestiacp_server_id" />
                            <field name="hestiacp_package_name" />
                            <button name="action_hestiacp_sync_package" type="object"
                                    string="Sync Package to Server"
                                    class="btn-secondary" />
                        </group>
                        <group string="Resource Limits">
                            <field name="hestiacp_disk_quota" />
                            <field name="hestiacp_bandwidth" />
                            <field name="hestiacp_web_domains" />
                            <field name="hestiacp_dns_domains" />
                            <field name="hestiacp_mail_accounts" />
                            <field name="hestiacp_databases" />
                            <field name="hestiacp_backups" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
