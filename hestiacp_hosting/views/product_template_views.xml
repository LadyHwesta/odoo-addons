<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_product_template_form_hestiacp" model="ir.ui.view">
        <field name="name">product.template.form.hestiacp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hosting Package" name="hestiacp">
                    <group>
                        <field name="is_hosting_package" />
                    </group>
                    <group invisible="not is_hosting_package">
                        <group string="HestiaCP">
                            <field name="hestiacp_server_id" />
                            <field name="hestiacp_package_name"
                                   placeholder="Exact name of an existing package on the server" />
                            <field name="hestiacp_billing_period" />
                        </group>
                        <group string="Resource Limits (informational)">
                            <field name="hestiacp_disk_quota" />
                            <field name="hestiacp_bandwidth" />
                            <field name="hestiacp_web_domains" />
                            <field name="hestiacp_dns_domains" />
                            <field name="hestiacp_mail_accounts" />
                            <field name="hestiacp_databases" />
                            <field name="hestiacp_backups" />
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not is_hosting_package">
                        The HestiaCP package named above must already exist on the server
                        (Server &gt; Packages) - create/edit it there by hand and keep the
                        limits above matching it for reference. HestiaCP's Access Key
                        permission system has no category covering package management, so
                        this can't be pushed automatically.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
