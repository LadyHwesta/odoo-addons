<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_hestiacp_agreement_list" model="ir.ui.view">
        <field name="name">hestiacp.agreement.list</field>
        <field name="model">hestiacp.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="version" />
                <field name="active" />
                <field name="create_date" string="Created" />
            </list>
        </field>
    </record>

    <record id="view_hestiacp_agreement_form" model="ir.ui.view">
        <field name="name">hestiacp.agreement.form</field>
        <field name="model">hestiacp.agreement</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Draft template, not legal advice - have a lawyer review this for your
                    jurisdiction (especially the acceptable-use/anti-spam and
                    limitation-of-liability sections) before relying on it. Only one agreement
                    should be active at a time; archive the old one instead of editing it in
                    place once real customers have accepted it, so past acceptances still point
                    at the text they actually agreed to.
                </div>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="version" />
                        <field name="active" />
                    </group>
                    <field name="body_html" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hestiacp_agreement" model="ir.actions.act_window">
        <field name="name">Hosting Agreement</field>
        <field name="res_model">hestiacp.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
