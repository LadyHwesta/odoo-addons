<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_check_payment_status" model="ir.cron">
        <field name="name">HestiaCP: suspend/unsuspend/terminate accounts by payment status</field>
        <field name="model_id" ref="model_hestiacp_account" />
        <field name="state">code</field>
        <field name="code">model._cron_check_payment_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="mail_template_account_provisioned" model="mail.template">
        <field name="name">HestiaCP Account Provisioned</field>
        <field name="model_id" ref="model_hestiacp_account" />
        <field name="subject">Your hosting account is ready</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hi {{ object.partner_id.name }},</p>
                <p>Your hosting account on <strong>{{ object.product_id.name }}</strong> is
                   ready to go.</p>
                <p>
                    Control panel: <a t-att-href="object.control_panel_url">
                    {{ object.control_panel_url }}</a><br />
                    Username: <strong>{{ object.username }}</strong><br />
                    Password: <strong t-out="ctx.get('hestiacp_password')" />
                </p>
                <p>We'd recommend changing your password after your first login.</p>
            </div>
        </field>
    </record>

</odoo>
