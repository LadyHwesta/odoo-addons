<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_deployment_server_list" model="ir.ui.view">
        <field name="name">deployment.server.list</field>
        <field name="model">deployment.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="kind" />
                <field name="partner_id" />
                <field name="hostname" />
                <field name="bootstrap_state" />
                <field name="last_health_ok" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_deployment_server_form" model="ir.ui.view">
        <field name="name">deployment.server.form</field>
        <field name="model">deployment.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="kind" />
                            <field name="partner_id"
                                   invisible="kind != 'dedicated'" />
                            <field name="hostname" />
                        </group>
                        <group>
                            <field name="bootstrap_state" />
                            <field name="agent_url" />
                            <field name="agent_token" password="True" />
                            <field name="last_health_check" readonly="1" />
                            <field name="last_health_ok" readonly="1" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_deployment_server" model="ir.actions.act_window">
        <field name="name">Deployment Servers</field>
        <field name="res_model">deployment.server</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
