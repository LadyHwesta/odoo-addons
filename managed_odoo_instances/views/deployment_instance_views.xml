<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_deployment_instance_list" model="ir.ui.view">
        <field name="name">deployment.instance.list</field>
        <field name="model">deployment.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="domain" />
                <field name="partner_id" />
                <field name="server_id" />
                <field name="state" widget="badge"
                       decoration-success="state == 'live'"
                       decoration-warning="state in ('requested', 'bootstrap_pending', 'provisioning')"
                       decoration-danger="state == 'suspended'"
                       decoration-muted="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <record id="view_deployment_instance_form" model="ir.ui.view">
        <field name="name">deployment.instance.form</field>
        <field name="model">deployment.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request" type="object" string="Request"
                            class="btn-primary" invisible="state != 'requested' or project_id" />
                    <button name="action_create_vhost" type="object" string="Create Vhost"
                            invisible="state not in ('provisioning',)" />
                    <button name="action_issue_certificate" type="object"
                            string="Issue SSL Certificate"
                            invisible="state not in ('provisioning',)" />
                    <button name="action_create_database" type="object"
                            string="Create Database &amp; Install Apps"
                            invisible="state not in ('provisioning',)" />
                    <button name="action_mark_live" type="object" string="Mark Live"
                            class="btn-primary" invisible="state not in ('provisioning',)" />
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'live'" />
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('live', 'suspended')" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,bootstrap_pending,provisioning,live" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="server_id" />
                            <field name="domain" />
                            <field name="db_name" />
                        </group>
                        <group>
                            <field name="admin_email" />
                            <field name="company_name" />
                            <field name="app_ids" widget="many2many_tags" />
                            <field name="project_id" />
                            <field name="contract_id" />
                            <field name="payment_token_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_deployment_instance" model="ir.actions.act_window">
        <field name="name">Managed Odoo Instances</field>
        <field name="res_model">deployment.instance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
