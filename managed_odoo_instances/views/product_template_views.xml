<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_product_template_form_managed_odoo" model="ir.ui.view">
        <field name="name">product.template.form.managed.odoo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Managed Odoo Hosting">
                    <field name="is_managed_odoo_hosting" />
                    <field name="managed_odoo_hosting_kind"
                           invisible="not is_managed_odoo_hosting"
                           required="is_managed_odoo_hosting" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
