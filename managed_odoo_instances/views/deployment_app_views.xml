<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_deployment_app_list" model="ir.ui.view">
        <field name="name">deployment.app.list</field>
        <field name="model">deployment.app</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="module_names" />
                <field name="product_template_id" />
            </list>
        </field>
    </record>

    <record id="action_deployment_app" model="ir.actions.act_window">
        <field name="name">Deployable Apps</field>
        <field name="res_model">deployment.app</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
