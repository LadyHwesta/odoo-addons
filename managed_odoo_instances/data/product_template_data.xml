<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The two "hosting tier" products - selling one of these is
         what actually creates a deployment.instance (and, for
         dedicated, a new deployment.server) on order confirmation.
         list_price left at 0 here deliberately - real recurring
         billing comes from whichever deployment.app product(s) are
         sold alongside it (see sale_order.py), not from the tier
         product itself; set a real one-time setup fee by hand if
         wanted. -->

    <record id="product_managed_odoo_shared" model="product.template">
        <field name="name">Managed Odoo Hosting - Shared</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True" />
        <field name="is_managed_odoo_hosting" eval="True" />
        <field name="managed_odoo_hosting_kind">shared</field>
    </record>

    <record id="product_managed_odoo_dedicated" model="product.template">
        <field name="name">Managed Odoo Hosting - Dedicated VPS</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True" />
        <field name="is_managed_odoo_hosting" eval="True" />
        <field name="managed_odoo_hosting_kind">dedicated</field>
    </record>

    <!-- One sellable product per existing deployment.app preset -
         linked to those records from deployment_app_data.xml (which
         loads after this file - see the manifest's own data order).
         list_price is a placeholder; set your real recurring price
         per suite before actually selling one. -->

    <record id="product_managed_odoo_app_club" model="product.template">
        <field name="name">Managed Odoo App: Amateur Radio Club Suite</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True" />
        <field name="list_price">0.0</field>
    </record>

    <record id="product_managed_odoo_app_nonprofit" model="product.template">
        <field name="name">Managed Odoo App: Nonprofit Suite</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True" />
        <field name="list_price">0.0</field>
    </record>

    <record id="product_managed_odoo_app_paramedic" model="product.template">
        <field name="name">Managed Odoo App: Paramedical Tattoo Practice Suite</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True" />
        <field name="list_price">0.0</field>
    </record>
</odoo>
