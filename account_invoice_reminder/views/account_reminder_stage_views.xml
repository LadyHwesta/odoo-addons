<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_reminder_stage_view_list" model="ir.ui.view">
        <field name="model">account.reminder.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="days_offset" />
                <field name="mail_template_id" />
                <field name="active" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" optional="show" />
            </list>
        </field>
    </record>

    <record id="account_reminder_stage_view_form" model="ir.ui.view">
        <field name="model">account.reminder.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Overdue Reminder" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="days_offset" />
                            <field name="mail_template_id" />
                        </group>
                        <group>
                            <field name="active" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_reminder_stage" model="ir.actions.act_window">
        <field name="name">Payment Reminders</field>
        <field name="res_model">account.reminder.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reminder stage</p>
            <p>Each stage is a number of days before or after an
               invoice's due date, paired with the email it sends. A
               negative number sends before the invoice is due, zero
               on the due date itself, and a positive number once it's
               overdue.</p>
        </field>
    </record>

</odoo>
