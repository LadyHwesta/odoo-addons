<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_view_form_reminder" model="ir.ui.view">
        <field name="name">account.move.view.form.reminder</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='delivery_date']" position="after">
                <field name="sent_reminder_stage_ids" widget="many2many_tags" />
                <field name="last_reminder_date" />
            </xpath>
        </field>
    </record>

</odoo>
