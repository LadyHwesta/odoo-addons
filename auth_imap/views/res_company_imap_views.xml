<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_imap_form" model="ir.ui.view">
        <field name="name">res.company.imap.form</field>
        <field name="model">res.company.imap</field>
        <field name="arch" type="xml">
            <form string="IMAP Authentication Server">
                <header>
                    <button name="action_test_imap_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="company"/>
                        <field name="active"/>
                        <newline/>
                        <group string="Server Information">
                            <field name="imap_server"/>
                            <field name="imap_server_port"/>
                            <field name="imap_encryption"/>
                        </group>
                        <group string="Process Parameter">
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_company_imap_list" model="ir.ui.view">
        <field name="name">res.company.imap.list</field>
        <field name="model">res.company.imap</field>
        <field name="arch" type="xml">
            <list string="IMAP Authentication Servers">
                <field name="company"/>
                <field name="imap_server"/>
                <field name="imap_server_port"/>
                <field name="imap_encryption"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_res_company_imap" model="ir.actions.act_window">
        <field name="name">IMAP Authentication Servers</field>
        <field name="res_model">res.company.imap</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_company_imap"
              name="IMAP Authentication"
              parent="base.menu_users"
              action="action_res_company_imap"
              groups="base.group_system"
              sequence="60"/>

</odoo>
