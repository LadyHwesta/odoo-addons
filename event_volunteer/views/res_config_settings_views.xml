<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_event_volunteer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.event_volunteer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="registration_setting_container" position="inside">
                <setting id="event_volunteer_reminder_setting"
                         string="Volunteer reminder lead time"
                         help="How many days before an event its confirmed volunteers get a reminder email.">
                    <field name="volunteer_reminder_lead_days" />
                    <span class="text-muted">days before the event</span>
                </setting>
            </block>
        </field>
    </record>
</odoo>
