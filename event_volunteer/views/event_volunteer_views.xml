<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============ Volunteer Role ============ -->
    <record id="event_volunteer_role_view_list" model="ir.ui.view">
        <field name="model">event.volunteer.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="event_id" />
                <field name="name" />
                <field name="slot_count" />
                <field name="filled_count" string="Signed up" />
                <field name="seats_available" string="Still needed" />
                <field name="fill_state" widget="badge"
                       decoration-danger="fill_state == 'empty'"
                       decoration-warning="fill_state == 'partial'"
                       decoration-success="fill_state == 'full'"
                       decoration-info="fill_state == 'over'" />
            </list>
        </field>
    </record>

    <record id="event_volunteer_role_view_form" model="ir.ui.view">
        <field name="model">event.volunteer.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" />
                            <field name="name" />
                            <field name="slot_count" />
                        </group>
                        <group>
                            <field name="filled_count" />
                            <field name="confirmed_count" />
                            <field name="seats_available" />
                            <field name="fill_state" />
                        </group>
                    </group>
                    <field name="description" placeholder="What this role involves..." />
                    <field name="assignment_ids" context="{'default_event_id': event_id}">
                        <list editable="bottom">
                            <field name="partner_id" />
                            <field name="state" />
                            <field name="source" />
                            <field name="note" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="event_volunteer_role_action" model="ir.actions.act_window">
        <field name="name">Volunteer Roles</field>
        <field name="res_model">event.volunteer.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Volunteer Assignment ============ -->
    <record id="event_volunteer_assignment_view_list" model="ir.ui.view">
        <field name="model">event.volunteer.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_id" />
                <field name="role_id" />
                <field name="partner_id" />
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'" />
                <field name="source" optional="hide" />
                <field name="note" optional="hide" />
                <field name="reminder_sent" optional="hide" />
                <field name="event_date_begin" optional="hide" />
            </list>
        </field>
    </record>

    <record id="event_volunteer_assignment_view_form" model="ir.ui.view">
        <field name="model">event.volunteer.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" readonly="1" />
                            <field name="role_id"
                                   domain="[('event_id', '=', event_id)]" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="source" />
                            <field name="reminder_sent" />
                        </group>
                    </group>
                    <field name="note" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="event_volunteer_assignment_view_search" model="ir.ui.view">
        <field name="model">event.volunteer.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id" />
                <field name="role_id" />
                <field name="partner_id" />
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]" />
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]" />
                <separator />
                <filter name="upcoming" string="Upcoming events"
                        domain="[('event_date_begin', '>=', context_today().strftime('%Y-%m-%d'))]" />
                <group>
                    <filter name="group_event" string="Event"
                            context="{'group_by': 'event_id'}" />
                    <filter name="group_role" string="Role"
                            context="{'group_by': 'role_id'}" />
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="event_volunteer_assignment_action" model="ir.actions.act_window">
        <field name="name">Volunteers</field>
        <field name="res_model">event.volunteer.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="event_volunteer_assignment_view_search" />
        <field name="context">{'search_default_upcoming': 1, 'search_default_group_event': 1}</field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_event_volunteers"
              name="Volunteers"
              parent="event.event_main_menu"
              action="event_volunteer_assignment_action"
              sequence="5"
              groups="event.group_event_user" />
    <menuitem id="menu_event_volunteer_roles"
              name="Volunteer Roles"
              parent="event.menu_event_configuration"
              action="event_volunteer_role_action"
              sequence="20"
              groups="event.group_event_manager" />
</odoo>
