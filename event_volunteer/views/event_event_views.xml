<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_event_form_volunteer" model="ir.ui.view">
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_volunteer_assignments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-hand-paper-o"
                        invisible="volunteer_slot_count == 0">
                    <field name="volunteer_filled_count" widget="statinfo"
                           string="Volunteers" />
                </button>
            </div>
            <notebook position="inside">
                <page string="Volunteers" name="volunteers">
                    <field name="volunteer_understaffed" invisible="1" />
                    <div class="alert alert-warning" role="alert"
                         invisible="not volunteer_understaffed">
                        Some volunteer roles still need people.
                    </div>
                    <field name="volunteer_role_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="slot_count" />
                            <field name="filled_count" string="Signed up" />
                            <field name="seats_available" string="Still needed" />
                            <field name="fill_state" widget="badge"
                                   decoration-danger="fill_state == 'empty'"
                                   decoration-warning="fill_state == 'partial'"
                                   decoration-success="fill_state == 'full'"
                                   decoration-info="fill_state == 'over'" />
                            <field name="description" optional="hide" />
                        </list>
                        <form>
                            <group>
                                <field name="name" />
                                <field name="slot_count" />
                            </group>
                            <field name="description"
                                   placeholder="What this role involves..." />
                            <field name="assignment_ids"
                                   context="{'default_event_id': parent.id}">
                                <list editable="bottom">
                                    <field name="partner_id" />
                                    <field name="state" />
                                    <field name="source" />
                                    <field name="note" />
                                </list>
                            </field>
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
