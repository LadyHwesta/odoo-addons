<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="event_description_full_volunteers"
              inherit_id="website_event.event_description_full"
              name="Event page: volunteer roles">
        <xpath expr="//div[@id='o_wevent_event_main_col']" position="inside">
            <section id="event_volunteer_roles" t-if="event.volunteer_role_ids"
                     class="mt-5 pt-3 border-top">
                <h4 class="mb-3">Volunteer</h4>

                <t t-set="v_msg" t-value="request.params.get('volunteer_msg')" />
                <div t-if="v_msg"
                     t-attf-class="alert alert-#{'success' if request.params.get('volunteer_ok') == '1' else 'warning'}"
                     role="alert">
                    <span t-esc="v_msg" />
                </div>

                <p t-if="request.env.user._is_public()" class="text-muted">
                    <a t-attf-href="/web/login?redirect=#{request.httprequest.path}">Sign in</a>
                    to sign up for a volunteer role.
                </p>

                <t t-set="is_member" t-value="not request.env.user._is_public()" />
                <div class="row g-3">
                    <t t-foreach="event.volunteer_role_ids" t-as="role">
                        <!-- assignment_ids is not readable by the public user,
                             so only touch it for a signed-in visitor. -->
                        <t t-set="mine" t-value="role.env['event.volunteer.assignment']" />
                        <t t-if="is_member"
                           t-set="mine"
                           t-value="role.assignment_ids.filtered(lambda a: a.partner_id == request.env.user.partner_id and a.state != 'cancelled')[:1]" />
                        <div class="col-12 col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="mb-1" t-esc="role.name" />
                                    <span t-attf-class="badge #{'text-bg-success' if role.seats_available == 0 else 'text-bg-secondary'}">
                                        <t t-esc="role.filled_count" />/<t t-esc="role.slot_count" />
                                    </span>
                                </div>
                                <p t-if="role.description" class="text-muted small"
                                   t-esc="role.description" />

                                <t t-if="is_member">
                                    <form t-if="mine"
                                          t-attf-action="/event/volunteer/#{mine.id}/withdraw"
                                          method="post" class="mt-2">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()" />
                                        <span class="text-success me-2">
                                            <i class="fa fa-check" /> You're signed up
                                        </span>
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Withdraw
                                        </button>
                                    </form>
                                    <form t-elif="role.seats_available &gt; 0"
                                          t-attf-action="/event/#{event.id}/volunteer/#{role.id}"
                                          method="post" class="mt-2">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()" />
                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            Volunteer
                                        </button>
                                    </form>
                                    <span t-else="" class="badge text-bg-success mt-2">
                                        Role filled
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
