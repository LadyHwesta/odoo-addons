<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pwa_icon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web.pwa.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Both the pre-existing app-name field and web_pwa_customize's
                 own short-name/colors/icon fields live in this block, and
                 all of them are normally hidden unless developer mode is
                 on. General Settings itself already requires admin access,
                 so dropping this restriction adds no real exposure. -->
            <xpath expr="//block[@id='pwa_settings']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
        </field>
    </record>

</odoo>
