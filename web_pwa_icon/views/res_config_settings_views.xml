<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pwa_icon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web.pwa.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- The whole block (including the pre-existing app-name
                 setting) is normally hidden unless developer mode is on.
                 Once you're bothering to set a custom icon, you almost
                 certainly want the name field visible too without having
                 to flip that switch - General Settings itself already
                 requires admin access, so dropping this restriction adds
                 no real exposure. -->
            <xpath expr="//block[@id='pwa_settings']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//block[@id='pwa_settings']/setting" position="after">
                <setting id="pwa_icon_setting"
                         help="Square image, at least 512x512, ideally with no transparency - some platforms mask it into a circle or squircle. Leave empty to keep Odoo's own icon.">
                    <field name="pwa_icon" widget="image" class="oe_avatar"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
