<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record id="import_user" model="res.users">
            <field name="name">Forum Archive Import</field>
            <field name="login">forum-archive-import</field>
            <field name="active" eval="False" />
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]" />
        </record>

        <record id="forum_activities" model="forum.forum">
            <field name="name">Activities</field>
            <field name="sequence">10</field>
            <field name="description">Club activities, outings, and things members are doing.</field>
        </record>
        <record id="forum_announcements" model="forum.forum">
            <field name="name">Announcements and News</field>
            <field name="sequence">20</field>
            <field name="description">Club announcements and news of general interest.</field>
        </record>
        <record id="forum_technical" model="forum.forum">
            <field name="name">Technical Questions and Answers</field>
            <field name="sequence">30</field>
            <field name="description">Ask and answer technical amateur-radio questions.</field>
        </record>

    </data>
</odoo>
