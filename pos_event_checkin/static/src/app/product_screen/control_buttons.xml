<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_event_checkin.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]" position="before">
            <button class="o_event_checkin_button" t-att-class="buttonClass" t-on-click="() => this.clickEventCheckIn()">
                <i class="fa fa-ticket me-1"/>Check In
            </button>
        </xpath>
    </t>
</templates>
