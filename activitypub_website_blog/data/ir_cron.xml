<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_activitypub_blog_catch_up" model="ir.cron">
        <field name="name">ActivityPub: catch up blog posts that never federated</field>
        <field name="model_id" ref="website_blog.model_blog_post"/>
        <field name="state">code</field>
        <field name="code">model._cron_federate_catch_up()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
