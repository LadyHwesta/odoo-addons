<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Odoo's stock homepage stays at "/" unless something points it
             elsewhere - the /our-club page above recreates the old site's
             front page content, but nothing serves it at "/" without this.
             noupdate="1" so re-installing this module won't fight an admin
             who later re-points the homepage somewhere else by hand. -->
        <record id="website.default_website" model="website">
            <field name="homepage_url">/our-club</field>
        </record>

    </data>
</odoo>
